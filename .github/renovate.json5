{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'config:recommended',
  ],
  customManagers: [
    {
      customType: 'regex',
      fileMatch: ['^src/chezmoi/\\.chezmoidata/bin/[^/]+\\.toml$'],
      matchStrings: [
        'repo\\s*=\\s*"(?<depName>[^"]+)"[\\s\\S]*?version\\s*=\\s*"(?<currentValue>[^"]+)"',
        'version\\s*=\\s*"(?<currentValue>[^"]+)"[\\s\\S]*?repo\\s*=\\s*"(?<depName>[^"]+)"',
      ],
      datasourceTemplate: 'github-releases',
      versioningTemplate: 'semver',
    },
  ],
  packageRules: [
    {
      matchDatasources: ['github-releases'],
      matchFileNames: ['src/chezmoi/.chezmoidata/bin/**'],
      commitMessagePrefix: 'chore(deps):',
      commitMessageTopic: '{{depName}}',
    },
  ],
}
