{{- /* chezmoi:modify-template */ -}}
{{- /*
  Cleanup only: agy plugins now converge through the agy CLI (plugin bridge), not
  ~/.gemini/config/plugins.json. This removes the entries an earlier version of this
  file added, and passes everything else through unchanged. Delete this file once
  the old entries are gone from every machine.
*/ -}}
{{- $old := list (joinPath .chezmoi.destDir ".local/share/agent-plugins/marketplace/plugins") -}}
{{- $plugin := dig "ai" "plugins" "superpowers" (dict) . -}}
{{- $old = append $old (dir (joinPath .chezmoi.destDir (dig "path" ".local/share/agent-plugins/marketplaces/superpowers-marketplace/plugins/superpowers" $plugin))) -}}
{{- if .chezmoi.stdin -}}
{{-   $config := fromJson .chezmoi.stdin -}}
{{-   $entries := dig "entries" list $config -}}
{{-   $kept := list -}}
{{-   range $entries -}}
{{-     if not (has (dig "path" "" .) $old) -}}
{{-       $kept = append $kept . -}}
{{-     end -}}
{{-   end -}}
{{-   if eq (len $kept) (len $entries) -}}
{{-     .chezmoi.stdin -}}
{{-   else -}}
{{-     $config = set $config "entries" $kept -}}
{{-     $config | toPrettyJson | trimSuffix "\n" -}}
{{-   end -}}
{{- end -}}
