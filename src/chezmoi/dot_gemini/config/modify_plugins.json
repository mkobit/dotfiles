{{- /* chezmoi:modify-template */ -}}
{{- /* Manages ~/.gemini/config/plugins.json */ -}}
{{- $agyMethod := dig "local" "bin" "agy" "installation_method" "none" . -}}
{{- if ne $agyMethod "none" -}}
{{-   $config := dict "entries" list -}}
{{-   if .chezmoi.stdin -}}
{{-     $config = fromJson .chezmoi.stdin -}}
{{-   end -}}
{{-   $entries := dig "entries" list $config -}}
{{-   $targets := list (joinPath .chezmoi.destDir ".local/share/agent-plugins/marketplace/plugins") -}}
{{-   $plugin := dig "ai" "plugins" "superpowers" (dict) . -}}
{{-   if eq (dig "installation_method" "none" $plugin) "chezmoi_external" -}}
{{-     $targets = append $targets (dir (joinPath .chezmoi.destDir (dig "path" ".local/share/agent-plugins/marketplaces/superpowers-marketplace/plugins/superpowers" $plugin))) -}}
{{-   end -}}
{{-   $changed := false -}}
{{-   range $targetPath := $targets -}}
{{-     $hasEntry := false -}}
{{-     range $entries -}}
{{-       if eq (dig "path" "" .) $targetPath -}}
{{-         $hasEntry = true -}}
{{-       end -}}
{{-     end -}}
{{-     if not $hasEntry -}}
{{-       $entries = append $entries (dict "path" $targetPath) -}}
{{-       $changed = true -}}
{{-     end -}}
{{-   end -}}
{{-   if $changed -}}
{{-     $config = set $config "entries" $entries -}}
{{-     $config | toPrettyJson | trimSuffix "\n" -}}
{{-   else -}}
{{-     .chezmoi.stdin -}}
{{-   end -}}
{{- else -}}
{{-   .chezmoi.stdin -}}
{{- end -}}
