{{- /*
  Emits tombstones that immediately prune known catalog skills
  (.chezmoidata/ai/skills.toml) and agents-as-skills
  (.chezmoidata/ai/agents.toml) that do not target
  ~/.gemini/antigravity-cli/skills (antigravity CLI global skills): state
  "absent", or a tool-name state for another tool, plus the old flat copies of
  base bare and retired skills from the shared ai/retired-skills list.
*/ -}}
{{- $antigravityEnabled := ne (dig "local" "bin" "agy" "installation_method" "none" $) "none" -}}
{{- if $antigravityEnabled -}}
{{- range $sourceName, $source := .ai.skills.external -}}
{{-   range $skillName, $state := dig "skills" (dict) $source -}}
{{-     if not (or (eq $state "present") (eq $state "antigravity")) }}
antigravity-cli/skills/{{ $skillName }}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /* Base bare skills reach Antigravity through the mkobit-dotfiles plugin, not flat copies. */ -}}
{{- range $skillName := includeTemplate "ai/retired-skills" . | fromJson }}
antigravity-cli/skills/{{ $skillName }}
{{- end -}}
{{- range $sourceName, $source := .ai.agents.external -}}
{{-   range $agentPath, $state := dig "agents" (dict) $source -}}
{{-     if not (or (eq $state "present") (eq $state "antigravity")) }}
antigravity-cli/skills/{{ base $agentPath }}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- end }}

# Deprecated legacy Gemini CLI settings
settings.json
