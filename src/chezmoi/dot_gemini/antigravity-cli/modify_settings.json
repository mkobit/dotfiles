{{- /* chezmoi:modify-template */ -}}
{{- /* Manages ~/.gemini/antigravity-cli/settings.json */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $agyMethod := dig "local" "bin" "agy" "installation_method" "none" . -}}
{{- if ne $agyMethod "none" -}}
{{-   $agAllow := list -}}
{{-   $agDeny := list -}}
{{-   range $cmd, $mode := dig "ai" "command_policy" "commands" (dict) . -}}
{{-     if eq $mode "allow" -}}
{{-       $agAllow = append $agAllow (printf "command(%s)" (regexQuoteMeta $cmd)) -}}
{{-     else if eq $mode "deny" -}}
{{-       $agDeny = append $agDeny (printf "command(%s)" (regexQuoteMeta $cmd)) -}}
{{-     end -}}
{{- /* "ask" renders nowhere — same "absence = normal prompt" logic as
   the Claude side. deny(...) key name is inferred from Antigravity's
   documented "Deny > Ask > Allow" precedence, not yet live-tested —
   harmless today since nothing sets "deny" here. */ -}}
{{-   end -}}
{{-   $liveAllow   := dig "permissions" "allow"  (list) $config -}}
{{-   $ensureAllow := dig "gemini" "permissions" "allow"  (list) . -}}
{{-   $removeAllow := dig "gemini" "permissions" "remove" (list) . -}}
{{-   $merged      := concat $agAllow $ensureAllow $liveAllow | uniq | sortAlpha -}}
{{-   $finalAllow  := list -}}
{{-   range $entry := $merged -}}
{{-     if not (has $entry $removeAllow) -}}
{{-       $finalAllow = append $finalAllow $entry -}}
{{-     end -}}
{{-   end -}}
{{-   $agPermissions := dict "allow" $finalAllow -}}
{{-   if gt (len $agDeny) 0 -}}
{{-     $agPermissions = set $agPermissions "deny" ($agDeny | uniq | sortAlpha) -}}
{{-   end -}}
{{-   $agentMode := dig "gemini" "general" "agent_mode" (dig "gemini" "agent_mode" "accept-edits" .) . -}}
{{-   $settings := dict
        "agentMode" $agentMode
        "enableTelemetry" .gemini.telemetry.enabled
        "showFeedbackSurvey" .gemini.general.show_feedback_survey
        "ui" (dict
          "showLineNumbers" .gemini.ui.show_line_numbers
          "showMemoryUsage" .gemini.ui.show_memory_usage
          "showModelInfoInChat" .gemini.ui.show_model_info_in_chat
          "footer" (dict "hideContextPercentage" .gemini.ui.footer.hide_context_percentage)
        )
        "general" (dict
          "enableAutoUpdate" (dig "local" "bin" "agy" "auto_update" .gemini.general.enable_auto_update .)
          "previewFeatures" .gemini.general.preview_features
          "sessionRetention" (dict
            "enabled" .gemini.general.sessionRetention.enabled
            "maxAge" .gemini.general.sessionRetention.max_age
            "warningAcknowledged" .gemini.general.sessionRetention.warning_acknowledged
          )
        )
        "security" (dict
          "auth" (dict
            "selectedType" "oauth-personal"
          )
        )
        "permissions" $agPermissions
        "tools" (dict
          "sandbox" .gemini.tools.sandbox
          "sandboxAllowedPaths" .gemini.tools.sandbox_allowed_paths
        )
        "context" (dict
          "includeDirectories" .gemini.context.include_directories
        )
        "experimental" (dict
          "worktrees" .gemini.experimental.worktrees
        )
  -}}
{{-   if .gemini.general.vim_mode -}}
{{-     $settings = set $settings "editorMode" "vim" -}}
{{-     $vimInsertFirst := dig "gemini" "general" "vim_insert_first" true . -}}
{{-     $settings = set $settings "vimInsertFirst" $vimInsertFirst -}}
{{-   end -}}
{{-   $config = mergeOverwrite $config $settings -}}
{{-   $config = set $config "statusLine" (dict "type" "command" "command" "statusline antigravity render" "enabled" true) -}}
{{-   $config = omit $config "title" -}}
{{- else -}}
{{-   $config = omit $config "statusLine" "title" -}}
{{- end -}}
{{- $config | toPrettyJson | trimSuffix "\n" -}}
