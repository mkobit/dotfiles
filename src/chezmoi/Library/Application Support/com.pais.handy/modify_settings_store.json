{{/* chezmoi:modify-template */}}
{{- if and (or (hasKey . "text_replacements") (hasKey . "handy")) .chezmoi.stdin -}}
{{- $store := .chezmoi.stdin | fromJson -}}
{{- $settings := get $store "settings" -}}
{{- $handy := get . "handy" | default dict -}}
{{- $rules := mergeOverwrite (dict) (get $handy "custom_words" | default dict) (get . "text_replacements" | default dict) -}}
{{- $desiredWords := list -}}
{{- range $rules -}}
{{- if not (kindIs "bool" .) -}}
{{- $desiredWords = append $desiredWords . -}}
{{- end -}}
{{- end -}}
{{- $desiredWords = $desiredWords | uniq | sortAlpha -}}
{{- if ne (get $settings "custom_words" | toJson) ($desiredWords | toJson) -}}
{{- $_ := set $settings "custom_words" $desiredWords -}}
{{- $store | toPrettyJson }}
{{ else -}}
{{- .chezmoi.stdin -}}
{{- end -}}
{{- else -}}
{{- .chezmoi.stdin -}}
{{- end -}}
