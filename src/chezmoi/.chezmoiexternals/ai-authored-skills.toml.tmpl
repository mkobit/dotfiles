{{- /*
  Generates one file external per (present authored skill file, tool dir) from
  the catalog in .chezmoidata/ai/skills.toml. Authored skills are full
  directory trees under ai/skills/<skill>/ adjacent to the chezmoi source;
  nested paths are preserved. file:// URLs read straight from that combined
  source tree and refreshPeriod re-reads them on every
  apply, keeping package snapshots in sync with local edits. The state-manifest
  cleanup hook continues to manage Antigravity's flattened global skill roots.
*/ -}}
{{- $bundle := ".local/share/agent-plugins/marketplace/plugins/mkobit-dotfiles" -}}
{{- $tools := dict "claude" (printf "%s/claude/skills" $bundle) "codex" (printf "%s/codex/skills" $bundle) "cursor" (printf "%s/cursor/skills" $bundle) -}}
{{- $cursorLocal := ".cursor/plugins/local/mkobit-dotfiles/skills" -}}
{{- $portable := printf "%s/skills" $bundle -}}
{{- $antigravity := ".gemini/antigravity-cli/skills" -}}
{{- $effectiveRoot := . -}}
{{- $root := joinPath .chezmoi.sourceDir ".." "ai/skills" -}}
{{- $antigravityEnabled := ne (dig "local" "bin" "agy" "installation_method" "none" $) "none" -}}
{{- $config := dict -}}
{{- range $skillName, $state := dig "authored" (dict) .ai.skills -}}
{{-   if or (eq $state "present") (hasKey $tools $state) (eq $state "antigravity") -}}
{{-     $skillDir := joinPath $root $skillName -}}
{{-     if not (or (stat (joinPath $skillDir "SKILL.md")) (stat (joinPath $skillDir "SKILL.md.tmpl"))) -}}
{{-       fail (printf "ai.skills.authored.%s: missing SKILL.md or SKILL.md.tmpl" $skillName) -}}
{{-     end -}}
{{-     $targets := dict -}}
{{-     $found := false -}}
{{-     range $path := glob (joinPath $skillDir "**/*") -}}
{{-       if eq (lstat $path).type "file" -}}
{{-         $found = true -}}
{{-         $rel := trimPrefix (printf "%s/" $skillDir) $path -}}
{{-         $rel = trimSuffix ".tmpl" $rel -}}
{{-         if hasKey $targets $rel -}}{{- fail (printf "authored skill filename collision: %s/%s" $skillName $rel) -}}{{- end -}}
{{-         $_ := set $targets $rel true -}}
{{-         $entry := includeTemplate "ai/authored-file-entry" (dict "root" $effectiveRoot "path" $path "target" $rel) | fromJson -}}
{{-         if eq $state "present" -}}
{{-           $_ := set $config (printf "%s/%s/%s" $portable $skillName $rel) $entry -}}
{{-           if $antigravityEnabled -}}
{{-             $_ := set $config (printf "%s/%s/%s" $antigravity $skillName $rel) $entry -}}
{{-           end -}}
{{-           range $_, $skillsDir := $tools -}}
{{-             $_ := set $config (printf "%s/%s/%s" $skillsDir $skillName $rel) $entry -}}
{{-           end -}}
{{-           $_ := set $config (printf "%s/%s/%s" $cursorLocal $skillName $rel) $entry -}}
{{-         else if hasKey $tools $state -}}
{{-           $_ := set $config (printf "%s/%s/%s" (index $tools $state) $skillName $rel) $entry -}}
{{-           if eq $state "cursor" -}}
{{-             $_ := set $config (printf "%s/%s/%s" $cursorLocal $skillName $rel) $entry -}}
{{-           end -}}
{{-         else if and (eq $state "antigravity") $antigravityEnabled -}}
{{-           $_ := set $config (printf "%s/%s/%s" $antigravity $skillName $rel) $entry -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-     if not $found -}}
{{-       fail (printf "ai.skills.authored.%s: no files found under %s" $skillName $skillDir) -}}
{{-     end -}}
{{-   else if ne $state "absent" -}}
{{-     fail (printf "ai.skills.authored.%s: state must be \"present\", \"absent\", or a tool name (%s), got %q" $skillName (concat (keys $tools) (list "antigravity") | sortAlpha | join ", ") $state) -}}
{{-   end -}}
{{- end -}}
{{- if $config -}}{{- toToml $config -}}{{- end -}}
