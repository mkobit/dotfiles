{{- /*
  Generates one archive external per (present skill, active tool) from the
  catalog in .chezmoidata/ai/skills.toml. Each external downloads the pinned
  upstream archive (verified against sha256, cached once per URL) and pipes it
  through skill_filter to re-root a single skill directory in the capability
  bundle.
  A source with "skill_file" set (flat, single-skill repo with SKILL.md at
  the archive root instead of a skills_root/<name>/ subdirectory) selects
  that bare file directly rather than a subtree.
  The filter must stay stdlib-only because uv and mise are not installed until
  after apply; python/filter-interpreter resolves which interpreter runs it.
  Portable, Claude, Codex, and Cursor snapshots retain the existing state
  targeting under the stable mkobit-dotfiles capability identity. Antigravity
  remains on its existing flattened global skill lifecycle. Overlays deselect
  skills via "absent" states rather than disabling a target.
*/ -}}
{{- $cfg := .ai.skills -}}
{{- $bundle := ".local/share/agent-plugins/marketplace/plugins/mkobit-dotfiles" -}}
{{- $tools := dict "claude" (printf "%s/.claude-plugin/skills" $bundle) "codex" (printf "%s/.codex-plugin/skills" $bundle) "cursor" (printf "%s/.cursor-plugin/skills" $bundle) -}}
{{- $portable := printf "%s/skills" $bundle -}}
{{- $antigravity := ".gemini/antigravity-cli/skills" -}}
{{- $python := includeTemplate "python/filter-interpreter" . -}}
{{- $script := joinPath .chezmoi.workingTree "src/python/skill_filter/skill_filter/main.py" -}}
{{- $config := dict -}}
{{- $selectedSkills := dict -}}
{{- $authoredPackagePaths := dict -}}
{{- range $skillName, $state := dig "authored" (dict) $cfg -}}
{{-   if eq $state "present" -}}
{{-     $_ := set $authoredPackagePaths (printf "%s/%s" $portable $skillName) (printf "ai.skills.authored.%s" $skillName) -}}
{{-     range $_, $skillsDir := $tools -}}
{{-       $_ := set $authoredPackagePaths (printf "%s/%s" $skillsDir $skillName) (printf "ai.skills.authored.%s" $skillName) -}}
{{-     end -}}
{{-   else if hasKey $tools $state -}}
{{-     $_ := set $authoredPackagePaths (printf "%s/%s" (index $tools $state) $skillName) (printf "ai.skills.authored.%s" $skillName) -}}
{{-   end -}}
{{- end -}}
{{- range $sourceName, $source := $cfg.external -}}
{{-   range $skillName, $state := dig "skills" (dict) $source -}}
{{-     if or (eq $state "present") (hasKey $tools $state) -}}
{{-       if hasKey $selectedSkills $skillName -}}
{{-         fail (printf "duplicate capability skill %q from ai.skills.external.%s and ai.skills.external.%s" $skillName (index $selectedSkills $skillName) $sourceName) -}}
{{-       end -}}
{{-       $_ := set $selectedSkills $skillName $sourceName -}}
{{-       $externalPackagePaths := list -}}
{{-       if eq $state "present" -}}
{{-         $externalPackagePaths = append $externalPackagePaths (printf "%s/%s" $portable $skillName) -}}
{{-         range $_, $skillsDir := $tools -}}
{{-           $externalPackagePaths = append $externalPackagePaths (printf "%s/%s" $skillsDir $skillName) -}}
{{-         end -}}
{{-       else -}}
{{-         $externalPackagePaths = append $externalPackagePaths (printf "%s/%s" (index $tools $state) $skillName) -}}
{{-       end -}}
{{-       range $path := $externalPackagePaths -}}
{{-         if hasKey $authoredPackagePaths $path -}}
{{-           fail (printf "duplicate capability package path %q from ai.skills.external.%s.skills.%s and %s" $path $sourceName $skillName (index $authoredPackagePaths $path)) -}}
{{-         end -}}
{{-       end -}}
{{-       if or (not (dig "ref" "" $source)) (not (dig "sha256" "" $source)) -}}
{{-         fail (printf "ai.skills.external.%s: ref and sha256 are required (versions are always pinned)" $sourceName) -}}
{{-       end -}}
{{-       $url := dig "url" "" $source -}}
{{-       if not $url -}}
{{-         $hostName := dig "host" "github" $source -}}
{{-         $host := dig $hostName (dict) $cfg.hosts -}}
{{-         if not $host -}}
{{-           fail (printf "ai.skills.external.%s: unknown host %q (no ai.skills.hosts.%s entry)" $sourceName $hostName $hostName) -}}
{{-         end -}}
{{-         $url = $host.url_format | replace "{repo}" $source.repo | replace "{ref}" $source.ref -}}
{{-       end -}}
{{-       $skillFile := dig "skill_file" "" $source -}}
{{-       $selectArg := $skillFile -}}
{{-       if not $skillFile -}}
{{-         $selectArg = printf "%s/%s:." (dig "skills_root" "skills" $source) $skillName -}}
{{-       end -}}
{{-       $entry := dict
                "type" "archive"
                "url" $url
                "checksum" (dict "sha256" $source.sha256)
                "exact" true
                "format" "tar"
                "filter" (dict
                  "command" $python
                  "args" (list "-S" $script "--cache-key" $source.sha256 "--select" $selectArg))
-}}
{{-       if eq $state "present" -}}
{{-         $_ := set $config (printf "%s/%s" $portable $skillName) $entry -}}
{{-         $_ := set $config (printf "%s/%s" $antigravity $skillName) $entry -}}
{{-       end -}}
{{-       range $toolName, $skillsDir := $tools -}}
{{-         if or (eq $state "present") (eq $state $toolName) -}}
{{-           $_ := set $config (printf "%s/%s" $skillsDir $skillName) $entry -}}
{{-         end -}}
{{-       end -}}
{{-     else if ne $state "absent" -}}
{{-       fail (printf "ai.skills.external.%s.skills.%s: state must be \"present\", \"absent\", or a tool name (%s), got %q" $sourceName $skillName (keys $tools | sortAlpha | join ", ") $state) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if $config -}}{{- toToml $config -}}{{- end -}}
