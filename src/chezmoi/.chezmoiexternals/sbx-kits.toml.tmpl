{{- /*
  Generates externals for Docker Sandboxes (sbx) kits from .chezmoidata/sbx/kits.toml.
  Deploys external sandboxes to .local/share/sbx/external/sandboxes/<name> and mixins to .local/share/sbx/external/mixins/<name>.
*/ -}}
{{- $cfg := dig "sbx" "kits" (dict) . -}}
{{- $config := dict -}}
{{- /* External kits */ -}}
{{- range $kitName, $source := dig "external" (dict) $cfg -}}
{{-   if or (contains "/" $kitName) (contains "\\" $kitName) (contains ".." $kitName) -}}
{{-     fail (printf "sbx.kits.external.%s: kit name must not contain path separators or \"..\"" $kitName) -}}
{{-   end -}}
{{-   $state := dig "state" "present" $source -}}
{{-   if eq $state "present" -}}
{{-     if or (not (dig "ref" "" $source)) (not (dig "sha256" "" $source)) -}}
{{-       fail (printf "sbx.kits.external.%s: ref and sha256 are required (versions are always pinned)" $kitName) -}}
{{-     end -}}
{{-     $hostName := dig "host" "github" $source -}}
{{-     $host := dig $hostName (dict) $cfg.hosts -}}
{{-     if not $host -}}
{{-       fail (printf "sbx.kits.external.%s: unknown host %q" $kitName $hostName) -}}
{{-     end -}}
{{-     $url := $host.url_format | replace "{repo}" $source.repo | replace "{ref}" $source.ref -}}
{{-     $kind := dig "kind" "sandbox" $source -}}
{{-     if and (ne $kind "sandbox") (ne $kind "mixin") -}}
{{-       fail (printf "sbx.kits.external.%s: kind must be \"sandbox\" or \"mixin\", got %q" $kitName $kind) -}}
{{-     end -}}
{{-     $targetDir := printf ".local/share/sbx/external/%ses/%s" $kind $kitName -}}
{{-     $entry := dict
          "type" "archive"
          "url" $url
          "checksum" (dict "sha256" $source.sha256)
          "exact" true
          "stripComponents" 1
-}}
{{-     $_ := set $config $targetDir $entry -}}
{{-   else if ne $state "absent" -}}
{{-     fail (printf "sbx.kits.external.%s: state must be \"present\" or \"absent\", got %q" $kitName $state) -}}
{{-   end -}}
{{- end -}}
{{- if $config -}}{{- toToml $config -}}{{- end -}}
