{{- /*
  Generates externals for Docker Sandboxes (sbx) kits from .chezmoidata/sbx/kits.toml.
  Deploys external sandboxes to .local/share/sbx/sandboxes/<name> and mixins to .local/share/sbx/mixins/<name>.
  Deploys authored kits from src/sbx/ to .local/share/sbx/ using file:// externals.
*/ -}}
{{- $cfg := dig "sbx" "kits" (dict) . -}}
{{- $root := joinPath .chezmoi.workingTree "src/sbx" -}}
{{- $config := dict -}}
{{- /* Authored mixins */ -}}
{{- range $kitName, $state := dig "authored" "mixins" (dict) $cfg -}}
{{-   if eq $state "present" -}}
{{-     $kitDir := joinPath $root "mixins" $kitName -}}
{{-     range $path := glob (joinPath $kitDir "**/*") -}}
{{-       if eq (lstat $path).type "file" -}}
{{-         $rel := trimPrefix (printf "%s/" $kitDir) $path -}}
{{-         $entry := dict
              "type" "file"
              "url" (printf "file://%s" $path)
              "refreshPeriod" "1s"
-}}
{{-         $_ := set $config (printf ".local/share/sbx/mixins/%s/%s" $kitName $rel) $entry -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /* Authored sandboxes */ -}}
{{- range $kitName, $state := dig "authored" "sandboxes" (dict) $cfg -}}
{{-   if eq $state "present" -}}
{{-     $kitDir := joinPath $root "sandboxes" $kitName -}}
{{-     range $path := glob (joinPath $kitDir "**/*") -}}
{{-       if eq (lstat $path).type "file" -}}
{{-         $rel := trimPrefix (printf "%s/" $kitDir) $path -}}
{{-         $entry := dict
              "type" "file"
              "url" (printf "file://%s" $path)
              "refreshPeriod" "1s"
-}}
{{-         $_ := set $config (printf ".local/share/sbx/sandboxes/%s/%s" $kitName $rel) $entry -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- /* External kits */ -}}
{{- range $kitName, $source := dig "external" (dict) $cfg -}}
{{-   $state := dig "state" "present" $source -}}
{{-   if eq $state "present" -}}
{{-     if or (not (dig "ref" "" $source)) (not (dig "sha256" "" $source)) -}}
{{-       fail (printf "sbx.kits.external.%s: ref and sha256 are required (versions are always pinned)" $kitName) -}}
{{-     end -}}
{{-     $hostName := dig "host" "github" $source -}}
{{-     $host := dig $hostName (dict) $cfg.hosts -}}
{{-     if not $host -}}
{{-       fail (printf "sbx.kits.external.%s: unknown host %q" $kitName $hostName) -}}
{{-     end -}}
{{-     $url := $host.url_format | replace "{repo}" $source.repo | replace "{ref}" $source.ref -}}
{{-     $kind := dig "kind" "sandbox" $source -}}
{{-     $targetDir := printf ".local/share/sbx/external/sandboxes/%s" $kitName -}}
{{-     if eq $kind "mixin" -}}
{{-       $targetDir = printf ".local/share/sbx/external/mixins/%s" $kitName -}}
{{-     end -}}
{{-     $entry := dict
          "type" "archive"
          "url" $url
          "checksum" (dict "sha256" $source.sha256)
          "exact" true
          "stripComponents" 1
-}}
{{-     $_ := set $config $targetDir $entry -}}
{{-   end -}}
{{- end -}}
{{- if $config -}}{{- toToml $config -}}{{- end -}}
