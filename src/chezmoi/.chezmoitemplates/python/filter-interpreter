{{- /*
  Resolves the python interpreter used as "filter.command" for chezmoi
  externals, and renders it as an absolute path.

  Include with includeTemplate, once per template, never per external:

    {{- $python := includeTemplate "python/filter-interpreter" . -}}

  Two rules, both of which exist because they were violated in practice:

  1. Never a bare command name and never lookPath. Both resolve through PATH,
     which on a machine with pyenv or mise lands on a version-manager shim.
     A shim costs ~900ms per spawn against ~30ms for a real interpreter, and
     these filters run hundreds of times per apply, so a shim turns an apply
     into minutes of pure process startup. A shim also resolves to whatever
     version its own config file names, which is state nobody declared here.
  2. Never a soft feature fallback. The filter is stdlib-only and holds a
     python 3.8 runtime contract (see src/python/skill_filter), so every
     candidate below is behaviourally identical and the choice is purely a
     startup-cost optimization. If the filter ever needs a newer stdlib
     (tomllib, for instance), raise the floor here and fail at render time
     rather than letting two interpreters produce two different results.

  Preference order is dotfiles-managed interpreters first, since those are the
  fastest to start and are the ones this repo installs, then the system
  interpreter as the always-present floor. Versions are tried newest-first
  explicitly rather than by sorting all matches, because an alphabetical sort
  puts "cpython-3.8" above "cpython-3.14".
*/ -}}
{{- $dest := .chezmoi.destDir -}}
{{- $minors := list "3.14" "3.13" "3.12" "3.11" -}}
{{- $roots := list
      "%s/.local/share/uv/python/cpython-%s*"
      "%s/.local/share/mise/installs/python/%s*"
-}}
{{- $found := "" -}}
{{- range $root := $roots -}}
{{-   range $minor := $minors -}}
{{-     if not $found -}}
{{-       range $dir := (glob (printf $root $dest $minor)) | sortAlpha | reverse -}}
{{-         if not $found -}}
{{-           $candidate := printf "%s/bin/python3" $dir -}}
{{-           if stat $candidate -}}
{{-             $found = $candidate -}}
{{-           end -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- if not $found -}}
{{-   $found = findExecutable "python3" (list "/usr/bin" "/usr/local/bin") -}}
{{- end -}}
{{- if not $found -}}
{{-   fail "python/filter-interpreter: found no python3 for external filters (looked for uv- and mise-managed 3.11+, then /usr/bin and /usr/local/bin)" -}}
{{- end -}}
{{- $found -}}
