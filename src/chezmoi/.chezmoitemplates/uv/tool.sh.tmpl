{{- $root := dig "local_bin_tools_root" .chezmoi.workingTree . -}}
MISE="{{ .chezmoi.destDir }}/.local/bin/mise"
{{ if eq .action "install" -}}
TOOL_NAME="{{ .name }}"
TOOL_PATH="{{ .path }}"

INSTALLED_TOOLS=$("$MISE" exec --cd "{{ $root }}" -- uv tool list)
if grep -q "$TOOL_NAME" <<< "$INSTALLED_TOOLS"; then
    echo "Updating $TOOL_NAME..."
else
    echo "Installing $TOOL_NAME..."
fi

"$MISE" exec --cd "{{ $root }}" -- uv tool install --force "$TOOL_PATH"
{{- else if eq .action "uninstall" -}}
TOOL_NAME="{{ .name }}"

INSTALLED_TOOLS=$("$MISE" exec --cd "{{ $root }}" -- uv tool list)
if grep -q "$TOOL_NAME" <<< "$INSTALLED_TOOLS"; then
    echo "Uninstalling $TOOL_NAME..."
    "$MISE" exec --cd "{{ $root }}" -- uv tool uninstall "$TOOL_NAME"
fi
{{- else -}}
{{- fail (printf "Unknown action '%s' for uv_tool template" .action) -}}
{{- end -}}
