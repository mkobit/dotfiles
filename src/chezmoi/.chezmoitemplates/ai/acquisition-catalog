{{- $capabilities := dig "capabilities" (dict) (dig "plugin_bridge" (dict) .ai) -}}
{{- $destination := "" -}}
{{- $destinationCount := 0 -}}
{{- range $name := keys $capabilities | sortAlpha -}}
{{-   $capability := index $capabilities $name -}}
{{-   if eq (dig "acquisition_destination" false $capability) true -}}
{{-     $destinationCount = add $destinationCount 1 -}}
{{-     $destination = $name -}}
{{-   end -}}
{{- end -}}
{{- if eq $destinationCount 0 -}}{{- fail "ai.plugin_bridge.capabilities must declare one acquisition_destination" -}}{{- end -}}
{{- if gt $destinationCount 1 -}}{{- fail "ai.plugin_bridge.capabilities must declare exactly one acquisition_destination" -}}{{- end -}}
{{- dict "skills" (dig "skills" (dict) .ai) "destination_capability" $destination | toJson -}}
