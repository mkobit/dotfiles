{{- /*
  Digest one authored file in process. Arguments: root, path (absolute canonical
  path), target (rendered relative name), and sha256 (the inventory hash).
  Templates hash their rendered bytes; plain files return the inventory sha256.
  Callers without an inventory record (authored plugins until they move to the
  inventory) hash the file bytes with include.
*/ -}}
{{- if hasSuffix ".tmpl" .path -}}
{{-   includeTemplate .path (includeTemplate "ai/authored-render-context" . | fromJson) | sha256sum -}}
{{- else if hasKey . "sha256" -}}
{{-   .sha256 -}}
{{- else -}}
{{-   include .path | sha256sum -}}
{{- end -}}
