{{- /*
  Version of the mkobit-dotfiles bundle from the generated inventory: bare skill
  tree digests, selected states and views, external selections, and rendered
  digests of templates in selected skills only. Independent of the checkout path.
*/ -}}
{{- $bare := (includeTemplate "ai/agent-sources" . | fromJson).bare -}}
{{- $inventory := dig "agent_source_inventory" "bare_skills" (dict) . -}}
{{- $repository := joinPath .chezmoi.sourceDir ".." -}}
{{- $skills := dict -}}
{{- range $name, $skill := $inventory -}}
{{-   $selection := index $bare.skills $name -}}
{{-   $rendered := dict -}}
{{-   if $selection.views -}}
{{-     range $target, $record := $skill.files -}}
{{-       if $record.template -}}
{{-         $_ := set $rendered $target (includeTemplate "ai/authored-file-digest" (dict "root" $ "path" (joinPath $repository $record.source) "target" $target "sha256" $record.sha256)) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $_ := set $skills $name (dict "digest" $skill.digest "state" $selection.state "views" $selection.views "rendered" $rendered) -}}
{{- end -}}
{{- $inputs := dict "external" (dig "ai" "skills" "external" (dict) .) "skills" $skills -}}
{{- printf "1.0.0+%s" (trunc 12 (sha256sum (toJson $inputs))) -}}
