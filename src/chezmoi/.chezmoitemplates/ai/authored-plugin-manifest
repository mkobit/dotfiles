{{- /*
  Render the generated host manifest of one discovered authored plugin.
  Arguments: root (root context), name (plugin name), and host (claude, codex, or cursor).
  Output: name, version, and description; "./skills" when the host has selected skills;
  wrapper components (mcpServers, rules); and, for codex only, the identity author and interface.
  The version digests the plugin inventory digest, the selection, and the rendered
  bytes of every selected template, so it changes with content and data only.
*/ -}}
{{- $plugin := dig "plugins" .name nil (includeTemplate "ai/agent-sources" .root | fromJson) -}}
{{- if not $plugin -}}{{- fail (printf "ai/authored-plugin-manifest: no discovered plugin %q" .name) -}}{{- end -}}
{{- $inventory := index .root.agent_source_inventory.plugins .name -}}
{{- /* Inventory paths are relative to sourceDir/.., the directory that holds chezmoi/, ai/ and overlay-plugins/. */ -}}
{{- $repository := joinPath .root.chezmoi.sourceDir ".." -}}
{{- $rendered := dict -}}
{{- range $host, $selected := $plugin.hosts -}}
{{-   range $skill := $selected.skills -}}
{{-     range $target, $record := (index $inventory.skills $skill).files -}}
{{-       if $record.template -}}
{{-         $_ := set $rendered (printf "skills/%s/%s" $skill $target) (includeTemplate "ai/authored-file-digest" (dict "root" $.root "path" (joinPath $repository $record.source) "target" $target "sha256" $record.sha256)) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   range $target, $record := dig "wrappers" $host "files" (dict) $inventory -}}
{{-     if $record.template -}}
{{-       $_ := set $rendered (printf "%s/%s" $host $target) (includeTemplate "ai/authored-file-digest" (dict "root" $.root "path" (joinPath $repository $record.source) "target" $target "sha256" $record.sha256)) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $inputs := dict "digest" $plugin.version_inputs.digest "selection" $plugin.version_inputs.selection "rendered" $rendered -}}
{{- $manifest := dict "name" .name "version" (printf "1.0.0+%s" (trunc 12 (sha256sum (toJson $inputs)))) "description" $plugin.description -}}
{{- $selected := dig .host (dict) $plugin.hosts -}}
{{- if dig "skills" (list) $selected -}}
{{-   $_ := set $manifest "skills" "./skills" -}}
{{- end -}}
{{- range $component, $path := dig "components" (dict) $selected -}}
{{-   $_ := set $manifest $component $path -}}
{{- end -}}
{{- if eq .host "codex" -}}
{{-   range $key := list "author" "interface" -}}
{{-     if index $inventory $key -}}
{{-       $_ := set $manifest $key (index $inventory $key) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $manifest | toPrettyJson -}}
