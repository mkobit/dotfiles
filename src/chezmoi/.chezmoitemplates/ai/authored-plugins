{{- /*
  Discover authored plugin folders and apply the machine decisions from the init template.
  Input: the root context. Output: a JSON object keyed by plugin name.

  A plugin is a source folder dot_local/share/agent-plugins/marketplace/exact_plugins/exact_<name>/.
  Identity: ai.plugins.<name> (description, optional author, optional host_dirs).
  Decisions: ai.plugin_bridge.default_hosts, and ai.plugin_bridge.capabilities.<name>
  with optional enabled (default true), hosts, environments, and skills.<skill> = "absent".

  Each entry has:
  - source: the absolute source folder;
  - enabled: false when enabled is false or environments excludes ai.plugin_bridge.environment;
  - hosts: the selected hosts;
  - packages: host -> package directory relative to the marketplace root,
    plugins/<name> by default or plugins/<name>/<host_dirs.<host>>;
  - skills: host -> selected skill names in that host package;
  - deselected: destination-relative paths that the init decisions remove.
*/ -}}
{{- $bridge := dig "ai" "plugin_bridge" (dict) . -}}
{{- $environment := dig "environment" "default" $bridge -}}
{{- $defaultHosts := dig "default_hosts" (list "claude" "codex" "cursor") $bridge -}}
{{- $sourceRoot := joinPath .chezmoi.sourceDir "dot_local/share/agent-plugins/marketplace/exact_plugins" -}}
{{- $targetRoot := ".local/share/agent-plugins/marketplace/plugins" -}}
{{- $plugins := dict -}}
{{- range $source := glob (joinPath $sourceRoot "exact_*") | sortAlpha -}}
{{-   if eq (lstat $source).type "symlink" -}}
{{-     fail (printf "authored plugin folder must not be a symlink, chezmoi deploys it empty: %s" $source) -}}
{{-   end -}}
{{-   if (stat $source).isDir -}}
{{-     $name := base $source | trimPrefix "exact_" -}}
{{-     if not (regexMatch "^[a-z0-9][a-z0-9-]*$" $name) -}}
{{-       fail (printf "authored plugin folder name must match [a-z0-9-]: %s" $source) -}}
{{-     end -}}
{{-     $identity := dig "ai" "plugins" $name (dict) $ -}}
{{-     $decision := dig "capabilities" $name (dict) $bridge -}}
{{-     $environments := dig "environments" nil $decision -}}
{{-     $enabled := and (dig "enabled" true $decision) (or (eq $environments nil) (has $environment $environments)) -}}
{{-     $hosts := dig "hosts" $defaultHosts $decision -}}
{{-     $exceptions := dig "skills" (dict) $decision -}}
{{-     range $host, $dir := dig "host_dirs" (dict) $identity -}}
{{-       if not (regexMatch "^[a-z0-9][a-z0-9-]*$" (toString $dir)) -}}
{{-         fail (printf "ai.plugins.%s.host_dirs.%s must be one folder name matching [a-z0-9-]" $name $host) -}}
{{-       end -}}
{{-     end -}}
{{-     $packages := dict -}}
{{-     $skills := dict -}}
{{-     $deselected := list -}}
{{-     if not $enabled -}}
{{-       $deselected = append $deselected (joinPath $targetRoot $name) -}}
{{-     else -}}
{{-       range $host, $dir := dig "host_dirs" (dict) $identity -}}
{{-         if not (has $host $hosts) -}}
{{-           $deselected = append $deselected (joinPath $targetRoot $name $dir) -}}
{{-         end -}}
{{-       end -}}
{{-     end -}}
{{-     range $host := $hosts -}}
{{-       $dir := dig "host_dirs" $host "" $identity -}}
{{-       $packageSource := $source -}}
{{-       $package := joinPath "plugins" $name -}}
{{-       if $dir -}}
{{-         $packageSource = joinPath $source (printf "exact_%s" $dir) -}}
{{-         $package = joinPath $package $dir -}}
{{-       end -}}
{{-       $_ := set $packages $host $package -}}
{{-       $selected := list -}}
{{-       range $skill := glob (joinPath $packageSource "exact_skills/exact_*") | sortAlpha -}}
{{-         if (stat $skill).isDir -}}
{{-           $skillName := base $skill | trimPrefix "exact_" -}}
{{-           if not (regexMatch "^[a-z0-9][a-z0-9-]*$" $skillName) -}}
{{-             fail (printf "authored skill folder name must match [a-z0-9-]: %s" $skill) -}}
{{-           end -}}
{{-           if eq (dig $skillName "present" $exceptions) "absent" -}}
{{-             $path := joinPath ".local/share/agent-plugins/marketplace" $package "skills" $skillName -}}
{{-             if and $enabled (not (has $path $deselected)) -}}
{{-               $deselected = append $deselected $path -}}
{{-             end -}}
{{-           else -}}
{{-             $selected = append $selected $skillName -}}
{{-           end -}}
{{-         end -}}
{{-       end -}}
{{-       $_ := set $skills $host $selected -}}
{{-     end -}}
{{-     $_ := set $plugins $name (dict "source" $source "enabled" $enabled "hosts" $hosts "packages" $packages "skills" $skills "deselected" $deselected) -}}
{{-   end -}}
{{- end -}}
{{- toJson $plugins -}}
