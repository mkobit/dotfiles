{{- /* Keep native registration consistent with upstream package acquisition. */ -}}
{{- $bridge := deepCopy (dig "ai" "plugin_bridge" (dict) .) -}}
{{- $sources := includeTemplate "ai/agent-sources" . | fromJson -}}
{{- $declared := dig "capabilities" (dict) $bridge -}}
{{- $capabilities := dict -}}
{{- /* Discovered plugins come from the inventory; data keys of the same name are selection exceptions. */ -}}
{{- range $name, $plugin := $sources.plugins -}}
{{-   $data := dig $name (dict) $declared -}}
{{-   if or (hasKey $data "external_source") (hasKey $data "acquisition_destination") -}}
{{-     fail (printf "ai.plugin_bridge.capabilities.%s: discovered plugin name equals an upstream or bundle capability" $name) -}}
{{-   end -}}
{{-   if $plugin.enabled -}}
{{-     $capability := dict "description" $plugin.description "marketplace" $plugin.marketplace "hosts" (keys $plugin.hosts | sortAlpha) -}}
{{-     $_ := set $capabilities $name (mergeOverwrite $capability (deepCopy $data)) -}}
{{-   end -}}
{{- end -}}
{{- range $name, $capability := $declared -}}
{{-   $source := dig "external_source" "" $capability -}}
{{-   if and (not (hasKey $sources.plugins $name)) (or (not $source) (eq (dig "ai" "plugins" $source "installation_method" "none" $) "chezmoi_external")) -}}
{{-     $_ := set $capabilities $name $capability -}}
{{-   end -}}
{{- end -}}
{{- $bundleHosts := $sources.bare.enabled_hosts -}}
{{- if and (hasKey $capabilities "mkobit-dotfiles") $bundleHosts -}}
{{-   $_ := set (index $capabilities "mkobit-dotfiles") "hosts" $bundleHosts -}}
{{- end -}}
{{- $_ := set $bridge "capabilities" $capabilities -}}
{{- $marketplaces := dict -}}
{{- range $name, $marketplace := dig "marketplaces" (dict) $bridge -}}
{{-   $source := dig "external_source" "" $marketplace -}}
{{-   if or (not $source) (eq (dig "ai" "plugins" $source "installation_method" "none" $) "chezmoi_external") -}}
{{-     if eq (dig "source_type" "" $marketplace) "generated" -}}
{{-       $path := dig "source_locator" ".local/share/agent-plugins/marketplace" $marketplace -}}
{{-       if not (isAbs $path) -}}
{{-         $_ := set $marketplace "source_locator" (joinPath $.chezmoi.destDir $path) -}}
{{-       end -}}
{{-     end -}}
{{-     $_ := set $marketplaces $name $marketplace -}}
{{-   end -}}
{{- end -}}
{{- $_ := set $bridge "marketplaces" $marketplaces -}}
{{- toJson $bridge -}}
