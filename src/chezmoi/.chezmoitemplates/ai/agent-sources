{{- /*
  Join the generated agent source inventory with control-plane selection data.
  Input is the root context; output is JSON that every consumer shares:
  {"bare": {"enabled_hosts", "antigravity", "skills": {s: {"state", "views"}}},
   "plugins": {n: {"enabled", "marketplace", "description", "hosts": {h: {"skills", "components"}},
                   "cursor_local", "version_inputs"}}}.
  Plugin hosts list only selected hosts; a disabled plugin has no hosts.
  A missing inventory renders empty, so chezmoi init and a cold chezmoi data stay valid.
*/ -}}
{{- $inventory := dig "agent_source_inventory" (dict) . -}}
{{- if $inventory -}}
{{-   if or (ne (toString (dig "schema" "" $inventory)) "1") (ne (dig "generator" "" $inventory) "skill_filter.agent_sources") -}}
{{-     fail "agent_source_inventory: unsupported schema or generator (the key is generated; never set it in configuration)" -}}
{{-   end -}}
{{- end -}}
{{- $bareSkills := dig "bare_skills" (dict) $inventory -}}
{{- $bridge := dig "ai" "plugin_bridge" (dict) . -}}
{{- if and (not (hasKey $bridge "default_hosts")) (or $bareSkills (dig "plugins" (dict) $inventory)) -}}
{{-   fail "ai.plugin_bridge.default_hosts is required when agent sources are discovered" -}}
{{- end -}}
{{- $hosts := list "claude" "codex" "cursor" -}}
{{- $enabledHosts := dig "capabilities" "mkobit-dotfiles" "hosts" (dig "default_hosts" (list) $bridge) $bridge -}}
{{- range $host := $enabledHosts -}}
{{-   if not (has $host $hosts) -}}
{{-     fail (printf "mkobit-dotfiles hosts: unknown host %q (expected one of %s)" $host (join ", " $hosts)) -}}
{{-   end -}}
{{- end -}}
{{- $antigravity := ne (dig "local" "bin" "agy" "installation_method" "none" .) "none" -}}
{{- $exceptions := dig "ai" "skills" "authored" (dict) . -}}
{{- $states := concat (list "present" "absent" "antigravity") $hosts -}}
{{- if $inventory -}}
{{-   range $name, $state := $exceptions -}}
{{-     if not (has $state $states) -}}
{{-       fail (printf "ai.skills.authored.%s: state must be one of %s, got %q" $name (join ", " (sortAlpha $states)) $state) -}}
{{-     end -}}
{{-     if and (not (hasKey $bareSkills $name)) (ne $state "absent") -}}
{{-       fail (printf "ai.skills.authored.%s: no authored skill src/ai/skills/%s; only \"absent\" may name a missing skill" $name $name) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- $skills := dict -}}
{{- range $name, $_ := $bareSkills -}}
{{-   $state := dig $name "present" $exceptions -}}
{{-   $views := list -}}
{{-   if eq $state "present" -}}
{{-     $views = append $views "portable" -}}
{{-   end -}}
{{-   range $host := $hosts -}}
{{-     if and (has $host $enabledHosts) (or (eq $state "present") (eq $state $host)) -}}
{{-       $views = append $views $host -}}
{{-     end -}}
{{-   end -}}
{{-   if or (eq $state "present") (eq $state "cursor") -}}
{{-     $views = append $views "cursor_local" -}}
{{-   end -}}
{{-   if and $antigravity (or (eq $state "present") (eq $state "antigravity")) -}}
{{-     $views = append $views "antigravity" -}}
{{-   end -}}
{{-   $_ := set $skills $name (dict "state" $state "views" $views) -}}
{{- end -}}
{{- $bare := dict "enabled_hosts" $enabledHosts "antigravity" $antigravity "skills" $skills -}}
{{- $environment := dig "environment" "default" $bridge -}}
{{- $plugins := dict -}}
{{- range $name, $plugin := dig "plugins" (dict) $inventory -}}
{{-   $capability := dig "capabilities" $name (dict) $bridge -}}
{{-   $prefix := printf "ai.plugin_bridge.capabilities.%s" $name -}}
{{-   $pluginHosts := dig "hosts" $bridge.default_hosts $capability -}}
{{-   if not (and (kindIs "slice" $pluginHosts) $pluginHosts) -}}
{{-     fail (printf "%s.hosts: must be a non-empty list" $prefix) -}}
{{-   end -}}
{{-   range $host := $pluginHosts -}}
{{-     if not (has $host $hosts) -}}
{{-       fail (printf "%s.hosts: unknown host %q (expected one of %s)" $prefix $host (join ", " $hosts)) -}}
{{-     end -}}
{{-   end -}}
{{-   $environments := dig "environments" nil $capability -}}
{{-   if and (ne $environments nil) (not (kindIs "slice" $environments)) -}}
{{-     fail (printf "%s.environments: must be a list" $prefix) -}}
{{-   end -}}
{{-   $enabled := or (eq $environments nil) (has $environment $environments) -}}
{{-   $skillStates := dig "skills" (dict) $capability -}}
{{-   $pluginStates := concat (list "present" "absent") $hosts -}}
{{-   range $skill, $state := $skillStates -}}
{{-     if not (has $state $pluginStates) -}}
{{-       fail (printf "%s.skills.%s: state must be one of %s, got %q" $prefix $skill (join ", " (sortAlpha $pluginStates)) $state) -}}
{{-     end -}}
{{-     if and (not (hasKey $plugin.skills $skill)) (ne $state "absent") -}}
{{-       fail (printf "%s.skills.%s: plugin %s has no skill %s; only \"absent\" may name a missing skill" $prefix $skill $name $skill) -}}
{{-     end -}}
{{-   end -}}
{{-   $selectedHosts := dict -}}
{{-   if $enabled -}}
{{-     range $host := $hosts -}}
{{-       if has $host $pluginHosts -}}
{{-         $hostSkills := list -}}
{{-         range $skill := keys $plugin.skills | sortAlpha -}}
{{-           $state := dig $skill "present" $skillStates -}}
{{-           if or (eq $state "present") (eq $state $host) -}}
{{-             $hostSkills = append $hostSkills $skill -}}
{{-           end -}}
{{-         end -}}
{{-         $components := dig "wrappers" $host "components" (dict) $plugin -}}
{{-         $_ := set $selectedHosts $host (dict "skills" $hostSkills "components" $components) -}}
{{-       end -}}
{{-     end -}}
{{-   end -}}
{{-   $cursorLocal := hasKey $selectedHosts "cursor" -}}
{{-   $selection := dict "enabled" $enabled "hosts" $selectedHosts "cursor_local" $cursorLocal -}}
{{-   $_ := set $plugins $name (dict
        "enabled" $enabled
        "marketplace" (dig "marketplace" "dotfiles" $capability)
        "description" $plugin.description
        "hosts" $selectedHosts
        "cursor_local" $cursorLocal
        "version_inputs" (dict "digest" $plugin.digest "selection" $selection)) -}}
{{- end -}}
{{- toJson (dict "bare" $bare "plugins" $plugins) -}}
