{{- $ai := dig "ai" (dict) . -}}
{{- $bridge := dig "plugin_bridge" (dict) $ai -}}
{{- $environment := dig "environment" "default" $bridge -}}
{{- dict
      "plan_version" 1
      "plugin_bridge" $bridge
      "skills" (dig "skills" (dict) $ai)
      "overlay_skills" (dig "overlay_skills" (dict) $ai)
      "acquired_sources" (dig "acquired_sources" (dict) $ai)
      "environment" $environment
      "working_tree" .chezmoi.workingTree
      "output_source_root" .chezmoi.sourceDir
    | toJson -}}
