#!/bin/sh
{{/* Enhanced sed compatibility for macOS BSD sed and Ubuntu GNU sed */}}
tempfile="$(mktemp)"
trap 'rm -rf "${tempfile}"' EXIT
cat > "${tempfile}"

# Remove existing chezmoi section if present
sed -i.bak '/.*modify_dot_zprofile\.tmpl:BEGIN:chezmoi:zsh/,/.*modify_dot_zprofile\.tmpl:END:chezmoi:zsh/d' "${tempfile}"

# Check if file ends with newline, if not add one
if [ -s "${tempfile}" ] && [ "$(tail -c1 "${tempfile}")" != "" ]; then
  echo >> "${tempfile}"
fi

# Add our managed section
cat >> "${tempfile}" << 'EOF'
# {{ .chezmoi.workingTree }}/{{ .chezmoi.sourceFile }}:BEGIN:chezmoi:zsh:{{ include "modify_dot_zprofile.tmpl" | sha256sum | substr 0 8 }} - WARNING: managed by chezmoi, do not edit
{{- $ctx := merge (dict "shell" "zsh") . }}
{{ template "shell/xdg_path.sh" $ctx }}
{{ template "shell/antigravity.sh" $ctx }}
{{ template "shell/telemetry.sh" $ctx }}
{{/* Keep early activation for interactive login shells until the work overlay
     confirms that activation from .zshrc alone preserves tool precedence.
     The helper runs only in interactive shells. In a clean non-interactive
     shell, use mise exec -- <tool> to run a mise-managed tool. */ -}}
{{ template "shell/mise.sh" $ctx }}
# {{ .chezmoi.workingTree }}/{{ .chezmoi.sourceFile }}:END:chezmoi:zsh:{{ include "modify_dot_zprofile.tmpl" | sha256sum | substr 0 8 }}
EOF

cat "${tempfile}"
