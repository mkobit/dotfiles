#!/usr/bin/env python3
"""Replace configured words in Handy transcripts and type the result on macOS."""

import base64
import ctypes
import json
import re
import sys

REPLACEMENTS = json.loads(base64.b64decode({{ .text_replacement_pairs | toJson | b64enc | quote }}))


def replace_words(text):
    pairs = sorted(REPLACEMENTS.items(), key=lambda pair: len(pair[0]), reverse=True)
    if not pairs:
        return text
    pattern = re.compile(
        "|".join(f"(?P<word{index}>(?<!\\w){re.escape(word)}(?!\\w))" for index, (word, _) in enumerate(pairs)),
        re.IGNORECASE,
    )
    return pattern.sub(lambda match: pairs[int(match.lastgroup[4:])][1], text)


def text_events(text):
    events = []
    start = 0
    while start < len(text):
        if text[start] in "\n\r\t":
            raise RuntimeError("Cannot insert a leading control character. Find the transcript in Handy history.")
        end = start
        units = 0
        while end < len(text):
            char_units = len(text[end].encode("utf-16-le")) // 2
            if units + char_units > 20:
                break
            units += char_units
            end += 1
        if end < len(text) and text[end] in "\n\r\t":
            split = end - 1
            while split > start and text[split] in "\n\r\t":
                split -= 1
            if split == start:
                raise RuntimeError(
                    "Cannot insert a long run of control characters. Find the transcript in Handy history."
                )
            end = split
        events.append(("text", text[start:end]))
        start = end
    return events


def show_error(message):
    core = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
    core.CFStringCreateWithCString.argtypes = (ctypes.c_void_p, ctypes.c_char_p, ctypes.c_uint32)
    core.CFStringCreateWithCString.restype = ctypes.c_void_p
    core.CFRelease.argtypes = (ctypes.c_void_p,)
    core.CFUserNotificationDisplayAlert.argtypes = (
        ctypes.c_double,
        ctypes.c_ulong,
        ctypes.c_void_p,
        ctypes.c_void_p,
        ctypes.c_void_p,
        ctypes.c_void_p,
        ctypes.c_void_p,
        ctypes.c_void_p,
        ctypes.c_void_p,
        ctypes.c_void_p,
        ctypes.POINTER(ctypes.c_ulong),
    )
    title = core.CFStringCreateWithCString(None, b"Handy paste failed", 0x08000100)
    detail = core.CFStringCreateWithCString(None, message.encode("utf-8"), 0x08000100)
    try:
        response = ctypes.c_ulong()
        core.CFUserNotificationDisplayAlert(
            0, 0, None, None, None, title, detail, None, None, None, ctypes.byref(response)
        )
    finally:
        core.CFRelease(title)
        core.CFRelease(detail)


def keyboard_services():
    quartz = ctypes.CDLL("/System/Library/Frameworks/ApplicationServices.framework/ApplicationServices")
    core = ctypes.CDLL("/System/Library/Frameworks/CoreFoundation.framework/CoreFoundation")
    quartz.AXIsProcessTrusted.restype = ctypes.c_bool
    quartz.CGEventCreateKeyboardEvent.argtypes = (ctypes.c_void_p, ctypes.c_uint16, ctypes.c_bool)
    quartz.CGEventCreateKeyboardEvent.restype = ctypes.c_void_p
    quartz.CGEventKeyboardSetUnicodeString.argtypes = (ctypes.c_void_p, ctypes.c_ulong, ctypes.POINTER(ctypes.c_uint16))
    quartz.CGEventSetFlags.argtypes = (ctypes.c_void_p, ctypes.c_uint64)
    quartz.CGEventPost.argtypes = (ctypes.c_uint32, ctypes.c_void_p)
    core.CFRelease.argtypes = (ctypes.c_void_p,)
    return quartz, core


def create_text_event(quartz, text):
    event = quartz.CGEventCreateKeyboardEvent(None, 0, True)
    if not event:
        raise RuntimeError("macOS could not create a keyboard event.")
    encoded = text.encode("utf-16-le")
    units = (ctypes.c_uint16 * (len(encoded) // 2)).from_buffer_copy(encoded)
    quartz.CGEventKeyboardSetUnicodeString(event, len(units), units)
    return event


def type_text(text):
    quartz, core = keyboard_services()
    if not quartz.AXIsProcessTrusted():
        raise RuntimeError(f"Enable Accessibility access for {sys.executable} to use Handy paste.")

    for _, value in text_events(text):
        event = create_text_event(quartz, value)
        try:
            quartz.CGEventSetFlags(event, 0)
            quartz.CGEventPost(0, event)
        finally:
            core.CFRelease(event)


def main():
    if len(sys.argv) != 2:
        raise RuntimeError("Handy must pass exactly one transcript argument.")
    type_text(replace_words(sys.argv[1]))


if __name__ == "__main__":
    try:
        main()
    except (OSError, RuntimeError, UnicodeError) as error:
        message = str(error) if not isinstance(error, UnicodeError) else "The transcript contains invalid Unicode."
        if "Handy history" not in message:
            message += " Find the transcript in Handy history."
        show_error(message)
        sys.exit(1)
