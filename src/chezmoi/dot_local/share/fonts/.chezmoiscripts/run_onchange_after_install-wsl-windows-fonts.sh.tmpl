{{- if and (eq (dig "wsl" "windows_integration" false . | toJson) "true") (eq .chezmoi.os "linux") (contains "microsoft" (get (default dict .chezmoi.kernel) "osrelease" | default "" | lower)) (lookPath "wslpath") (lookPath "powershell.exe") -}}
#!/usr/bin/env bash
set -euo pipefail

# fonts data hash: {{ .fonts | toToml | sha256sum }}

LINUX_SRC_FOLDER="{{ .chezmoi.destDir }}/.local/share/fonts/NerdFonts"
WINDOWS_SRC_FOLDER=$(wslpath -w "$LINUX_SRC_FOLDER")
if [[ -z "$WINDOWS_SRC_FOLDER" ]]; then
    echo "ERROR: Could not resolve the Windows path for the font source" >&2
    exit 1
fi

powershell.exe -NoProfile -Command "
\$ErrorActionPreference = 'Stop'
\$srcFolder = '${WINDOWS_SRC_FOLDER}'
\$destFolder = \"\$env:LOCALAPPDATA\Microsoft\Windows\Fonts\"

\$srcFiles = @(Get-ChildItem -LiteralPath \$srcFolder -File -Recurse |
    Where-Object { \$_.Extension -in '.ttf', '.otf' })
if (\$srcFiles.Count -eq 0) { return }

if (!(Test-Path -LiteralPath \$destFolder)) { New-Item -Path \$destFolder -ItemType Directory }

\$shell = New-Object -ComObject Shell.Application
\$fontsFolder = \$shell.Namespace(\$destFolder)
if (\$null -eq \$fontsFolder) { throw 'Could not open the Windows font folder' }

\$srcFiles | ForEach-Object {
    \$destFile = Join-Path \$destFolder \$_.Name
    if (Test-Path -LiteralPath \$destFile) {
        if (!(Test-Path -LiteralPath \$destFile -PathType Leaf)) {
            throw \"The font destination is not a file: \$destFile\"
        }
        Remove-Item -LiteralPath \$destFile -Force
    }
    \$fontsFolder.CopyHere(\$_.FullName, 0x14)
}
"
{{- end }}
