{{- $marketplace := .ai.plugin_bridge.marketplace -}}
{{- $bridge := .ai.plugin_bridge -}}
{{- $environment := dig "environment" "default" $bridge -}}
{{- $plugins := list -}}
{{- range $name, $capability := $bridge.capabilities -}}
{{-   $environments := dig "environments" nil $capability -}}
{{-   if or (eq $environments nil) (has $environment $environments) -}}
{{-     $plugins = append $plugins (dict "name" $name "source" (dict "source" $marketplace.source "path" (printf "./plugins/%s/codex" $name)) "policy" (dict "installation" "AVAILABLE" "authentication" "ON_INSTALL") "category" "Productivity") -}}
{{-   end -}}
{{- end -}}
{{- dict "name" $marketplace.name "interface" (dict "displayName" "Dotfiles") "plugins" $plugins | toPrettyJson -}}
