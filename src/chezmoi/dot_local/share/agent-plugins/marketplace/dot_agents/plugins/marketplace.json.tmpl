{{- $bridge := fromJson (includeTemplate "ai/plugin-bridge" .) -}}
{{- $marketplace := $bridge.marketplace -}}
{{- $environment := dig "environment" "default" $bridge -}}
{{- $plugins := list -}}
{{- range $name, $capability := $bridge.capabilities -}}
{{-   $capabilityMarketplace := dig "marketplace" "" $capability -}}
{{-   $marketplaceDefinition := dig $capabilityMarketplace (dict) $bridge.marketplaces -}}
{{-   $hosts := dig "hosts" (dig "hosts" (list) $marketplaceDefinition) $capability -}}
{{-   $environments := dig "environments" nil $capability -}}
{{-   if and (eq $capabilityMarketplace $marketplace.name) (has "codex" $hosts) (or (eq $environments nil) (has $environment $environments)) -}}
{{-     $path := dig "package_path" (printf "./plugins/%s/codex" $name) $capability -}}
{{-     $plugins = append $plugins (dict "name" $name "source" (dict "source" $marketplace.source "path" $path) "policy" (dict "installation" "AVAILABLE" "authentication" "ON_INSTALL") "category" "Productivity") -}}
{{-   end -}}
{{- end -}}
{{- dict "name" $marketplace.name "interface" (dict "displayName" "Dotfiles") "plugins" $plugins | toPrettyJson -}}
