{{- /*
  Prunes deselected external skills from the mkobit-dotfiles package and removes
  retired authored skills. Bare skill roots are exact_ and cleaned by the root cleanup.
*/ -}}
{{- $removals := dict -}}
{{- range $sourceName, $source := dig "external" (dict) (dig "skills" (dict) .ai) -}}
{{-   range $skillName, $state := dig "skills" (dict) $source -}}
{{-     if ne $state "present" -}}
{{-       $_ := set $removals (printf "skills/%s" $skillName) true -}}
{{-     end -}}
{{-     if and (ne $state "present") (ne $state "claude") -}}
{{-       $_ := set $removals (printf "claude/skills/%s" $skillName) true -}}
{{-     end -}}
{{-     if and (ne $state "present") (ne $state "codex") -}}
{{-       $_ := set $removals (printf "codex/skills/%s" $skillName) true -}}
{{-     end -}}
{{-     if and (ne $state "present") (ne $state "cursor") -}}
{{-       $_ := set $removals (printf "cursor/skills/%s" $skillName) true -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- range $skillName := (includeTemplate "ai/retired-skills" . | fromJson) -}}
{{-   range $root := list "skills" "claude/skills" "codex/skills" "cursor/skills" -}}
{{-     $_ := set $removals (printf "%s/%s" $root $skillName) true -}}
{{-   end -}}
{{- end -}}
{{- range $path := keys $removals | sortAlpha }}
{{ $path }}
{{- end }}

# Retired custom command approval hooks.
hooks.json
codex/hooks/hooks.json
