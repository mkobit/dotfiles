{{- $marketplace := .ai.plugin_bridge.marketplace -}}
{{- $bridge := .ai.plugin_bridge -}}
{{- $environment := dig "environment" "default" $bridge -}}
{{- $plugins := list -}}
{{- range $name, $capability := $bridge.capabilities -}}
{{-   $environments := dig "environments" nil $capability -}}
{{-   if or (eq $environments nil) (has $environment $environments) -}}
{{-     $plugins = append $plugins (dict "name" $name "source" (printf "./plugins/%s/claude" $name)) -}}
{{-   end -}}
{{- end -}}
{{- dict "name" $marketplace.name "owner" (dict "name" $marketplace.owner) "plugins" $plugins | toPrettyJson -}}
