{{- $personal := dig "git" "personal" (dict) . }}
{{- if dig "enabled" false $personal }}
{{- $sshSigningKey := dig "ssh_signing_key" "" $personal }}
{{- if not (and $personal.name $personal.email) }}
{{- fail "git.personal.enabled is true but name or email is empty" }}
{{- end }}

[user]
  name = {{ $personal.name | quote }}
  email = {{ $personal.email | quote }}
{{- if $sshSigningKey }}
  signingkey = {{ joinPath .chezmoi.destDir $sshSigningKey | quote }}
{{- else if $personal.signing_key }}
  signingkey = {{ $personal.signing_key }}
{{- end }}

[commit]
{{- if or $sshSigningKey $personal.signing_key }}
  gpgsign = true
{{- else }}
  gpgsign = false
{{- end }}

[gpg]
{{- if $sshSigningKey }}
  format = ssh
{{- else }}
  program = gpg
{{- end }}
{{- end }}