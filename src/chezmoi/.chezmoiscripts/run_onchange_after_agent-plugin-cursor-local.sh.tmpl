#!/bin/sh
# Cursor has no plugin install command. It loads a plugin from ~/.cursor/plugins/local/<name>/.
# This script owns that folder like an exact_ directory: after apply it holds exactly the
# plugins selected for Cursor in the plugin bridge (authored and external), copied from their
# deployed marketplace folders. Any other entry is removed. A symlinked folder is never followed.
# A marketplace the host provides has no local folder, so it is skipped.
# The version comments make run_onchange run again when a copied plugin or the selection changes.
# A failed copy prints a warning and never fails apply.
set -u

cursor_local={{ joinPath .chezmoi.destDir ".cursor/plugins/local" | shellQuote }}
{{- $bridge := includeTemplate "ai/plugin-bridge" . | fromJson }}
{{- $authored := includeTemplate "ai/authored-plugins" . | fromJson }}
{{- $selected := dict }}
{{- range $marketplace, $declaration := $bridge.marketplaces }}
{{-   if eq (dig "source_type" "" $declaration) "generated" }}
{{-     range $entry := includeTemplate "ai/marketplace-plugins" (dict "root" $ "name" $marketplace "host" "cursor") | fromJson }}
{{-       $version := dig "ai" "plugins" (dig "external_source" "" (index $bridge.capabilities $entry.name)) "sha256" "" $ }}
{{-       if hasKey $authored $entry.name }}{{ $version = includeTemplate "ai/plugin-version" (dict "root" $ "name" $entry.name) }}{{ end }}
{{-       $_ := set $selected $entry.name (dict "source" (joinPath $declaration.source_locator $entry.path) "version" $version) }}
{{-     end }}
{{-   end }}
{{- end }}

sync_plugin() {
    [ -d "$2" ] || return 0
    rm -rf "${cursor_local:?}/$1" && cp -R "$2" "$cursor_local/$1" ||
        printf 'agent-plugin-cursor-local: copy failed: %s\n' "$1" >&2
}

if [ -L "$cursor_local" ]; then
    printf 'agent-plugin-cursor-local: %s is a symlink, skipping\n' "$cursor_local" >&2
    exit 0
fi
mkdir -p "$cursor_local" || exit 0

for entry in "$cursor_local"/* "$cursor_local"/.[!.]*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    case "${entry##*/}" in
    {{- range $name := keys $selected | sortAlpha }}
    {{ $name }}) ;;
    {{- end }}
    *) rm -rf "$entry" ;;
    esac
done

{{ range $name := keys $selected | sortAlpha -}}
{{- $plugin := index $selected $name -}}
# {{ $name }} {{ $plugin.version }}
sync_plugin {{ $name | quote }} {{ $plugin.source | shellQuote }}
{{ end -}}
exit 0
