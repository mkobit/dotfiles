{{- if eq .chezmoi.os "linux" -}}
{{- /* Build snap package list from packages namespace */ -}}
{{- $snapPkgs := list -}}
{{- range $name, $tool := .packages -}}
{{-   $method := dig "installation_method" "" $tool -}}
{{-   if eq $method "snap" -}}
{{-     $snapPkgs = append $snapPkgs $name -}}
{{-   end -}}
{{- end -}}
{{- if $snapPkgs -}}
#!/usr/bin/env bash
# snap packages hash: {{ $snapPkgs | toJson | sha256sum }}

set -euo pipefail

source "{{ .chezmoi.sourceDir }}/.chezmoitemplates/shell/logging.sh"

if ! check_command snap; then
    log_warn "snap not found — skipping snap package installation"
    exit 0
fi

snap_packages_hash="{{ $snapPkgs | toJson | sha256sum }}"
state_dir="${XDG_STATE_HOME:-{{ .chezmoi.destDir }}/.local/state}/chezmoi"
cache_file="${state_dir}/snap-packages.hash"

if [ -f "$cache_file" ] && [ "$(cat "$cache_file" 2>/dev/null)" = "$snap_packages_hash" ]; then
    exit 0
fi

if check_sudo_access; then
    has_sudo_access=1
else
    has_sudo_access=0
fi

skipped_any=0

{{- range $snapPkgs }}
{{-   $tool := index $.packages . }}
{{-   $pkg := dig "package" "snap" (dict) $tool }}
{{-   $name := dig "name" . $pkg }}
{{-   $confinement := dig "confinement" "strict" $pkg }}

if snap list {{ $name }} &>/dev/null; then
    log_success "{{ $name }} already installed via snap"
elif [ "$has_sudo_access" -eq 1 ]; then
    log_info "Installing {{ $name }} via snap..."
    if sudo snap install {{ $name }}{{ if eq $confinement "classic" }} --classic{{ end }}; then
        log_success "{{ $name }} installed successfully via snap"
    else
        log_error "Failed to install {{ $name }} via snap"
        exit 1
    fi
else
    log_warn "No TTY and no cached sudo credentials — skipping {{ $name }} snap install, will retry next apply"
    skipped_any=1
fi
{{- end }}

if [ "$skipped_any" -eq 0 ]; then
    mkdir -p "$state_dir"
    echo "$snap_packages_hash" > "$cache_file"
fi
{{- end }}
{{- end }}
