{{- if eq .chezmoi.os "linux" -}}
{{- $aptPkgs := list -}}
{{- range $name, $tool := .packages -}}
{{-   $method := dig "installation_method" "" $tool -}}
{{-   if eq $method "apt" -}}
{{-     $aptPkgs = append $aptPkgs $name -}}
{{-   end -}}
{{- end -}}
{{- if $aptPkgs -}}
#!/usr/bin/env bash
# apt packages hash: {{ $aptPkgs | toJson | sha256sum }}

set -euo pipefail

source "{{ .chezmoi.sourceDir }}/.chezmoitemplates/shell/logging.sh"

if ! check_command apt-get; then
    log_error "apt-get not found — cannot install packages"
    exit 1
fi

apt_packages_hash="{{ $aptPkgs | toJson | sha256sum }}"
state_dir="${XDG_STATE_HOME:-{{ .chezmoi.destDir }}/.local/state}/chezmoi"
cache_file="${state_dir}/apt-packages.hash"

if [ -f "$cache_file" ] && [ "$(cat "$cache_file" 2>/dev/null)" = "$apt_packages_hash" ]; then
    exit 0
fi

if check_sudo_access; then
    has_sudo_access=1
else
    has_sudo_access=0
fi

skipped_any=0

{{- $ppaPkgs := list -}}
{{- range $aptPkgs -}}
{{-   $tool := index $.packages . -}}
{{-   $pkg  := dig "package" "apt" (dict) $tool -}}
{{-   if dig "ppa" "" $pkg -}}
{{-     $ppaPkgs = append $ppaPkgs . -}}
{{-   end -}}
{{- end -}}

{{- if $ppaPkgs }}
ppa_is_configured() {
    local ppa_path="${1#ppa:}" source_file source_format
    for source_file in /etc/apt/sources.list /etc/apt/sources.list.d/*.list /etc/apt/sources.list.d/*.sources; do
        [[ -r "$source_file" ]] || continue
        source_format="${source_file##*.}"
        if awk -v ppa_path="$ppa_path" -v source_format="$source_format" '
            function matching_uri(uri) {
                sub(/\/$/, "", uri)
                return uri == "https://ppa.launchpadcontent.net/" ppa_path "/ubuntu" ||
                    uri == "http://ppa.launchpadcontent.net/" ppa_path "/ubuntu" ||
                    uri == "https://ppa.launchpad.net/" ppa_path "/ubuntu" ||
                    uri == "http://ppa.launchpad.net/" ppa_path "/ubuntu"
            }
            function matching_stanza(    count, values, i, enabled) {
                enabled = tolower(fields["enabled"])
                gsub(/^[[:space:]]+|[[:space:]]+$/, "", enabled)
                if (enabled == "no" || fields["types"] !~ /(^|[[:space:]])deb([[:space:]]|$)/)
                    return 0
                count = split(fields["uris"], values, /[[:space:]]+/)
                for (i = 1; i <= count; i++)
                    if (matching_uri(values[i])) return 1
                return 0
            }
            /^[[:space:]]*#/ { next }
            source_format != "sources" {
                line = $0
                sub(/^[[:space:]]+/, "", line)
                if (line !~ /^deb[[:space:]]/) next
                sub(/^deb[[:space:]]+/, "", line)
                sub(/^\[[^]]*\][[:space:]]+/, "", line)
                split(line, parts, /[[:space:]]+/)
                if (matching_uri(parts[1])) found = 1
                next
            }
            /^[[:space:]]*$/ {
                if (matching_stanza()) found = 1
                delete fields
                key = ""
                next
            }
            /^[[:space:]]/ {
                line = $0
                sub(/^[[:space:]]+/, "", line)
                fields[key] = fields[key] " " line
                next
            }
            /^[^:]+:/ {
                key = tolower(substr($0, 1, index($0, ":") - 1))
                value = substr($0, index($0, ":") + 1)
                sub(/^[[:space:]]+/, "", value)
                sub(/[[:space:]]+$/, "", value)
                fields[key] = value
            }
            END { exit !(found || (source_format == "sources" && matching_stanza())) }
        ' "$source_file"; then
            return 0
        fi
    done
    return 1
}
{{- end }}

{{- range $aptPkgs }}
{{-   $tool := index $.packages . }}
{{-   $pkg := dig "package" "apt" (dict) $tool }}
{{-   $name := dig "name" . $pkg }}
{{-   $ppa := dig "ppa" "" $pkg }}
{{-   $service := dig "systemd" "service" "" $tool }}

{{- if $ppa }}
if ppa_is_configured {{ $ppa | quote }}; then
    log_success "apt repository {{ $ppa }} already configured"
elif [ "$has_sudo_access" -eq 1 ]; then
    if ! check_command add-apt-repository; then
        log_info "🔒 Installing software-properties-common for add-apt-repository..."
        sudo apt-get install -y software-properties-common \
            || { log_error "Failed to install software-properties-common"; exit 1; }
    fi
    log_info "🔒 Adding apt repository {{ $ppa }} for {{ $name }}..."
    sudo add-apt-repository -y --no-update {{ $ppa | quote }} \
        || { log_error "Failed to add repository {{ $ppa }} for {{ $name }}"; exit 1; }
    sudo apt-get update
else
    log_warn "No TTY and no cached sudo credentials — skipping repository {{ $ppa }}, will retry next apply"
    skipped_any=1
fi

if dpkg -l {{ $name }} 2>/dev/null | grep -q "^ii"; then
    log_success "{{ $name }} already installed via apt"
elif [ "$has_sudo_access" -eq 1 ]; then
    log_info "🔒 Installing {{ $name }} via apt (from {{ $ppa }})..."
    sudo apt-get install -y {{ $name }} \
        || { log_error "Failed to install {{ $name }} via apt"; exit 1; }
    log_success "{{ $name }} installed"
else
    log_warn "No TTY and no cached sudo credentials — skipping {{ $name }} install, will retry next apply"
    skipped_any=1
fi
{{- else }}
if dpkg -l {{ $name }} 2>/dev/null | grep -q "^ii"; then
    log_success "{{ $name }} already installed via apt"
elif [ "$has_sudo_access" -eq 1 ]; then
    log_info "🔒 Installing {{ $name }} via apt..."
    if ! sudo apt-get install -y {{ $name }}; then
        log_warn "Failed to install {{ $name }} via apt, updating apt cache and retrying..."
        sudo apt-get update
        sudo apt-get install -y {{ $name }} \
            || { log_error "Failed to install {{ $name }} via apt after update"; exit 1; }
    fi
    log_success "{{ $name }} installed"
else
    log_warn "No TTY and no cached sudo credentials — skipping {{ $name }} install, will retry next apply"
    skipped_any=1
fi
{{- end }}

{{- if $service }}
if check_command systemctl; then
    if systemctl is-enabled --quiet {{ $service }} 2>/dev/null && systemctl is-active --quiet {{ $service }}; then
        log_success "{{ $service }} already enabled and running"
    elif [ "$has_sudo_access" -eq 1 ]; then
        log_info "🔒 Enabling {{ $service }} service..."
        sudo systemctl enable --now {{ $service }} \
            || { log_error "Failed to enable {{ $service }} service"; exit 1; }
        log_success "{{ $service }} enabled and started"
    else
        log_warn "No TTY and no cached sudo credentials — skipping {{ $service }} enable, will retry next apply"
        skipped_any=1
    fi
else
    log_warn "systemctl not found — skipping {{ $service }} service enable"
fi
{{- end }}
{{- end }}

if [ "$skipped_any" -eq 0 ]; then
    mkdir -p "$state_dir"
    echo "$apt_packages_hash" > "$cache_file"
fi
{{- end }}
{{- end }}
