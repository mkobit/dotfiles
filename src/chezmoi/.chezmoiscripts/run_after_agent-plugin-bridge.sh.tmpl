#!/bin/sh
set -eu

# Reconcile on every apply so declared plugins recover from out-of-band drift.
{{ $python := includeTemplate "python/filter-interpreter" . -}}

destination={{ .chezmoi.destDir | quote }}
python_command={{ $python | quote }}
state_dir="$destination/.local/state/dotfiles"
ownership_file="$state_dir/agent-plugin-ownership"
legacy_ownership_file="$state_dir/agent-plugin-ownership.json"
desired_file="$state_dir/.agent-plugin-desired.$$"
owned_desired_file="$state_dir/.agent-plugin-owned-desired.$$"
migration_file="$state_dir/.agent-plugin-migration.$$"

mkdir -p "$state_dir"
: >"$desired_file"
: >"$owned_desired_file"
trap 'rm -f "$desired_file" "$owned_desired_file" "$migration_file"' EXIT HUP INT TERM

if [ ! -f "$ownership_file" ] && [ -f "$legacy_ownership_file" ]; then
  "$python_command" -S - "$legacy_ownership_file" >"$migration_file" <<'PY'
import json
import sys

with open(sys.argv[1], encoding="utf-8") as stream:
    resources = json.load(stream).get("resources", [])
for resource in resources:
    kind = resource["kind"]
    host = resource["host"]
    resource_id = resource["id"]
    if kind == "plugin":
        plugin, separator, marketplace = resource_id.rpartition("@")
        if not separator:
            raise SystemExit(f"invalid legacy plugin identity: {resource_id}")
    elif kind == "marketplace":
        marketplace = resource_id
        plugin = ""
    else:
        raise SystemExit(f"invalid legacy resource kind: {kind}")
    print(kind, host, marketplace, plugin, sep="\t")
PY
  mv "$migration_file" "$ownership_file"
fi

fail() {
  printf '%s\n' "agent-plugin-bridge: $*" >&2
  exit 1
}

require_command() {
  command -v "$1" >/dev/null 2>&1 ||
    fail "required host command is unavailable: $1"
}

record_desired() {
  identity=$(printf '%s\t%s\t%s\t%s' "$1" "$2" "$3" "$4")
  printf '%s\n' "$identity" >>"$desired_file"
  printf '%s\n' "$identity" >>"$owned_desired_file"
  touch "$ownership_file"
  grep -F -x "$identity" "$ownership_file" >/dev/null ||
    printf '%s\n' "$identity" >>"$ownership_file"
}

record_declared() {
  printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "$4" >>"$desired_file"
}

host_command() {
  case "$1" in
    claude) printf '%s\n' claude ;;
    codex) printf '%s\n' codex ;;
    *) fail "unsupported plugin host: $1" ;;
  esac
}

validate_cursor_name() {
  case "$1" in
    ""|.|..|*[!A-Za-z0-9._-]*) fail "invalid cursor plugin name: $1" ;;
  esac
}

cursor_plugin_path() {
  printf '%s\n' "$destination/.cursor/plugins/local/$1"
}

cursor_plugin_target() {
  printf '%s\n' "$destination/.local/share/agent-plugins/marketplace/plugins/$1/cursor"
}

json_has_identity() {
  field=$1
  expected=$2
  "$python_command" -S -c '
import json
import sys

value = json.load(sys.stdin)
records = value.get("marketplaces", []) if isinstance(value, dict) else value
if not isinstance(records, list):
    raise SystemExit("plugin host returned invalid JSON")
raise SystemExit(0 if any(isinstance(item, dict) and item.get(sys.argv[1]) == sys.argv[2] for item in records) else 1)
' "$field" "$expected"
}

marketplace_present() {
  host=$1
  marketplace=$2
  command=$(host_command "$host")
  case "$host" in
    claude)
      "$command" plugin marketplace list --json 2>/dev/null |
        json_has_identity name "$marketplace"
      ;;
    codex)
      "$command" plugin marketplace list 2>/dev/null |
        awk -v expected="$marketplace" '$1 == expected { found = 1 } END { exit !found }'
      ;;
  esac
}

ensure_marketplace() {
  host=$1
  marketplace=$2
  source_type=$3
  source_locator=$4
  [ "$host" = "cursor" ] && return 0
  command=$(host_command "$host")
  require_command "$command"

  if [ "$source_type" = "host-provided" ]; then
    marketplace_present "$host" "$marketplace" ||
      fail "host-provided marketplace is unavailable: $marketplace ($host)"
    record_declared marketplace "$host" "$marketplace" ""
    return
  fi

  [ -n "$source_locator" ] ||
    fail "generated marketplace has no source: $marketplace"
  if marketplace_present "$host" "$marketplace"; then
    if [ "$source_type" != "generated" ]; then
      case "$host" in
        claude) "$command" plugin marketplace update "$marketplace" ;;
        codex) "$command" plugin marketplace upgrade "$marketplace" ;;
      esac
    fi
  else
    "$command" plugin marketplace add "$source_locator"
  fi
  marketplace_present "$host" "$marketplace" ||
    fail "marketplace did not become available: $marketplace ($host)"
  record_desired marketplace "$host" "$marketplace" ""
}

plugin_present() {
  host=$1
  marketplace=$2
  plugin=$3
  if [ "$host" = "cursor" ]; then
    validate_cursor_name "$plugin"
    link=$(cursor_plugin_path "$plugin")
    target=$(cursor_plugin_target "$plugin")
    [ -d "$link" ] && [ ! -L "$link" ] && [ -d "$target" ]
    return
  fi
  command=$(host_command "$host")
  case "$host" in
    claude)
      "$command" plugin list --json 2>/dev/null |
        json_has_identity id "$plugin@$marketplace"
      ;;
    codex)
      "$command" plugin list -m "$marketplace" 2>/dev/null |
        awk -v expected="$plugin@$marketplace" '$1 == expected { found = 1 } END { exit !found }'
      ;;
  esac
}

ensure_plugin() {
  host=$1
  marketplace=$2
  plugin=$3
  if [ "$host" = "cursor" ]; then
    validate_cursor_name "$plugin"
    link=$(cursor_plugin_path "$plugin")
    target=$(cursor_plugin_target "$plugin")
    [ -d "$target" ] || fail "cursor plugin package is unavailable: $target"
    rm -rf -- "$link"
    mkdir -p "$(dirname "$link")"
    cp -R "$target" "$link"
    record_desired plugin "$host" "$marketplace" "$plugin"
    return
  fi
  command=$(host_command "$host")
  require_command "$command"

  if plugin_present "$host" "$marketplace" "$plugin"; then
    case "$host" in
      claude) "$command" plugin update "$plugin@$marketplace" ;;
      codex) "$command" plugin add "$plugin@$marketplace" ;;
    esac
  else
    case "$host" in
      claude) "$command" plugin install "$plugin@$marketplace" ;;
      codex) "$command" plugin add "$plugin@$marketplace" ;;
    esac
  fi

  if [ "$host" = "claude" ]; then
    "$command" plugin enable "$plugin@$marketplace"
  fi
  plugin_present "$host" "$marketplace" "$plugin" ||
    fail "plugin did not become available: $plugin@$marketplace ($host)"
  record_desired plugin "$host" "$marketplace" "$plugin"
}

remove_owned() {
  kind=$1
  [ -f "$ownership_file" ] || return 0
  while IFS="$(printf '\t')" read -r owned_kind host marketplace plugin; do
    [ "$owned_kind" = "$kind" ] || continue
    identity=$(printf '%s\t%s\t%s\t%s' "$owned_kind" "$host" "$marketplace" "$plugin")
    if ! grep -F -x "$identity" "$desired_file" >/dev/null; then
      if [ "$kind" = "plugin" ] && [ "$host" = "cursor" ]; then
        validate_cursor_name "$plugin"
        rm -rf -- "$(cursor_plugin_path "$plugin")"
        continue
      fi
      command=$(host_command "$host")
      require_command "$command"
      if [ "$kind" = "plugin" ]; then
        case "$host" in
          claude) "$command" plugin uninstall "$plugin@$marketplace" ;;
          codex) "$command" plugin remove "$plugin@$marketplace" ;;
        esac
      else
        case "$host" in
          claude) "$command" plugin marketplace remove "$marketplace" ;;
          codex) "$command" plugin marketplace remove "$marketplace" ;;
        esac
      fi
    fi
  done <"$ownership_file"
}

{{- $bridge := dig "plugin_bridge" (dict) (dig "ai" (dict) .) -}}
{{- $pluginEnvironment := dig "environment" "default" $bridge -}}
{{- $marketplaces := dig "marketplaces" (dict) $bridge -}}
{{- $plugins := dig "plugins" (dict) $bridge -}}
{{- $capabilities := dig "capabilities" (dict) $bridge -}}
{{- if not (kindIs "map" $marketplaces) -}}{{ fail "ai.plugin_bridge.marketplaces must be a table" }}{{ end -}}
{{- if not (kindIs "map" $plugins) -}}{{ fail "ai.plugin_bridge.plugins must be a table" }}{{ end -}}
{{- if not (kindIs "map" $capabilities) -}}{{ fail "ai.plugin_bridge.capabilities must be a table" }}{{ end -}}
{{- $rows := dict -}}
{{- range $name := keys $marketplaces | sortAlpha -}}
{{-   $definition := index $marketplaces $name -}}
{{-   $hosts := dig "hosts" (list) $definition -}}
{{-   $sourceType := dig "source_type" "" $definition -}}
{{-   $sourceLocator := dig "source_locator" "" $definition -}}
{{-   if and (eq $sourceType "generated") (not $sourceLocator) -}}{{- $sourceLocator = joinPath $.chezmoi.destDir ".local/share/agent-plugins/marketplace" -}}{{- end -}}
{{-   $order := dig "order" 100 $definition -}}
{{-   range $host := ($hosts | uniq | sortAlpha) -}}
{{-     $_ := set $rows (printf "10:%09d:%s:%s" $order $name $host) (dict "kind" "marketplace" "name" $name "host" $host "source_type" $sourceType "source_locator" $sourceLocator) -}}
{{-   end -}}
{{- end -}}
{{- range $name := keys $plugins | sortAlpha -}}
{{-   $definition := index $plugins $name -}}
{{-   $marketplace := dig "marketplace" "" $definition -}}
{{-   $marketplaceDefinition := index $marketplaces $marketplace -}}
{{-   $marketplaceHosts := dig "hosts" (list) $marketplaceDefinition -}}
{{-   $hosts := dig "hosts" $marketplaceHosts $definition -}}
{{-   $environments := dig "environments" (list) $definition -}}
{{-   $order := dig "order" 200 $definition -}}
{{-   if has $pluginEnvironment $environments -}}
{{-     range $host := ($hosts | uniq | sortAlpha) -}}
{{-       $_ := set $rows (printf "30:%09d:%s:%s" $order $name $host) (dict "kind" "plugin" "name" $name "host" $host "marketplace" $marketplace) -}}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- range $name := keys $capabilities | sortAlpha -}}
{{-   $definition := index $capabilities $name -}}
{{-   $marketplace := dig "marketplace" "" $definition -}}
{{-   $marketplaceDefinition := index $marketplaces $marketplace -}}
{{-   $marketplaceHosts := dig "hosts" (list) $marketplaceDefinition -}}
{{-   $hosts := dig "hosts" $marketplaceHosts $definition -}}
{{-   $order := dig "order" 200 $definition -}}
{{-   range $host := ($hosts | uniq | sortAlpha) -}}
{{-     $_ := set $rows (printf "20:%09d:%s:%s" $order $name $host) (dict "kind" "plugin" "name" $name "host" $host "marketplace" $marketplace) -}}
{{-   end -}}
{{- end -}}
{{- range $key := keys $rows | sortAlpha -}}
{{-   $row := index $rows $key -}}
{{-   if eq (index $row "kind") "marketplace" }}
ensure_marketplace {{ index $row "host" | quote }} {{ index $row "name" | quote }} {{ index $row "source_type" | quote }} {{ index $row "source_locator" | quote }}
{{-   else }}
ensure_plugin {{ index $row "host" | quote }} {{ index $row "marketplace" | quote }} {{ index $row "name" | quote }}
{{-   end -}}
{{- end }}

remove_owned plugin
remove_owned marketplace
mv "$owned_desired_file" "$ownership_file"
