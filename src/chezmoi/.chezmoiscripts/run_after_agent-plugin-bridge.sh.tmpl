#!/usr/bin/env sh
set -eu

{{ $python := includeTemplate "python/filter-interpreter" . -}}
{{- $bridge := fromJson (includeTemplate "ai/plugin-bridge" .) -}}
{{- $chezmoi := dig "chezmoi" (dict) . -}}
{{- $destination := dig "destDir" "." $chezmoi -}}
{{- $registration := dict "environment" (dig "environment" "default" $bridge) "marketplaces" (dig "marketplaces" (dict) $bridge) "plugins" (dig "plugins" (dict) $bridge) "capabilities" (dig "capabilities" (dict) $bridge) "retired_plugins" (dig "retired_plugins" (dict) $bridge) -}}
{{- $payload := dict "plugin_bridge" $registration -}}

destination={{ $destination | quote }}
python_command={{ $python | quote }}
bridge_helper={{ joinPath .chezmoi.sourceDir ".." "python/skill_filter/skill_filter/plugin_bridge.py" | quote }}

# DOTFILES_AGENT_PLUGIN_REFRESH=1 also updates owned public and internal marketplaces.
# shellcheck disable=SC2086
exec "$python_command" -S "$bridge_helper" reconcile --destination "$destination" ${DOTFILES_AGENT_PLUGIN_REFRESH:+--refresh} <<'EOF'
{{ toJson $payload }}
EOF
