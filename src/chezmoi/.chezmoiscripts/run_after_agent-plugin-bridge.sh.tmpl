#!/bin/sh
set -eu

{{ $python := includeTemplate "python/filter-interpreter" . -}}
{{ $bridge := dig "plugin_bridge" (dict) (dig "ai" (dict) .) -}}

destination={{ .chezmoi.destDir | quote }}
python_command={{ $python | quote }}
bridge_helper={{ joinPath .chezmoi.workingTree "src/python/skill_filter/skill_filter/plugin_bridge.py" | quote }}

exec "$python_command" -S "$bridge_helper" reconcile --destination "$destination" <<'EOF'
{{ toJson $bridge }}
EOF
