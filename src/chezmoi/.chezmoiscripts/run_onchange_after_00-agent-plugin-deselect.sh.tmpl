#!/bin/sh
# Remove authored plugin content that ai/plugin-ignore deselects.
# chezmoi keeps ignored entries inside exact_ folders, so this removes deployed copies.
# The rendered path list makes run_onchange run again when the deselection changes.
set -eu
set -f

destination={{ .chezmoi.destDir | shellQuote }}

remove() {
    # Refuse a symlink at any component, so removal never leaves the destination.
    path=$destination
    for part in $(printf '%s' "$1" | tr '/' ' '); do
        path=$path/$part
        if [ -L "$path" ]; then
            printf 'agent-plugin-deselect: refusing symlink: %s\n' "$path" >&2
            return 0
        fi
    done
    rm -rf -- "$path"
}

{{ range $name, $plugin := includeTemplate "ai/authored-plugins" . | fromJson -}}
{{   range $path := $plugin.deselected -}}
remove {{ $path | shellQuote }}
{{   end -}}
{{ end -}}
