{{- $replacements := dig "macos" "text_replacements" (dict) . -}}
{{- if and (eq .chezmoi.os "darwin") $replacements -}}
{{- if lookPath "python3" -}}
#!/usr/bin/env python3
"""Report configured macOS text replacements that need manual updates."""

import plistlib
import subprocess
import sys

desired = {{ $replacements | toJson }}

try:
    result = subprocess.run(["/usr/bin/defaults", "export", "-g", "-"], check=True, capture_output=True)
    current = plistlib.loads(result.stdout).get("NSUserDictionaryReplacementItems", [])
    for shortcut, phrase in desired.items():
        if not any(
            entry.get("on", True) and entry.get("replace") == shortcut and entry.get("with") == phrase
            for entry in current
        ):
            print(f"macOS text replacement missing or different: {shortcut} → {phrase}", file=sys.stderr)
except Exception as error:
    print(f"Could not check macOS text replacements: {type(error).__name__}", file=sys.stderr)
{{- else -}}
{{- warnf "Could not check macOS text replacements: python3 not found" -}}
{{- end -}}
{{- end }}
