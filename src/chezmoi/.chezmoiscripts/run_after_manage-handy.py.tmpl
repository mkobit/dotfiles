{{- $handy := get . "handy" | default dict -}}
{{- if and (eq .chezmoi.os "darwin") (get $handy "enabled") (lookPath "python3") -}}
{{- $rules := mergeOverwrite (dict) (get $handy "custom_words" | default dict) (get . "text_replacements" | default dict) -}}
{{- $words := list -}}
{{- range $rules -}}
{{- if not (kindIs "bool" .) -}}
{{- $words = append $words . -}}
{{- end -}}
{{- end -}}
#!/usr/bin/env python3
"""Merge configured Handy settings after stopping the app."""

import copy
import json
import os
import subprocess
import tempfile
import time
from pathlib import Path

path = Path({{ joinPath .chezmoi.destDir "Library" "Application Support" "com.pais.handy" "settings_store.json" | quote }})
desired = json.loads({{ omit (get $handy "settings" | default dict) "post_process_api_keys" | toJson | quote }})
key_env = json.loads({{ get $handy "api_key_env" | default dict | toJson | quote }})
lifecycle = json.loads({{ get $handy "lifecycle" | default dict | toJson | quote }})
words = json.loads({{ $words | uniq | sortAlpha | toJson | quote }})


def merge(current, changes):
    for key, value in changes.items():
        if isinstance(value, dict) and isinstance(current.get(key), dict):
            merge(current[key], value)
        elif key in ("post_process_providers", "post_process_prompts") and isinstance(value, list):
            existing = current.setdefault(key, [])
            for item in value:
                match = next((entry for entry in existing if entry.get("id") == item["id"]), None)
                if match is None:
                    existing.append(copy.deepcopy(item))
                else:
                    merge(match, item)
        else:
            current[key] = copy.deepcopy(value)


def updated(store):
    result = copy.deepcopy(store)
    settings = result.setdefault("settings", {})
    merge(settings, desired)
    settings["custom_words"] = words
    for provider, variable in key_env.items():
        if os.environ.get(variable):
            settings.setdefault("post_process_api_keys", {})[provider] = os.environ[variable]
    return result


def running():
    result = subprocess.run(["/usr/bin/pgrep", "-x", "handy"], stdout=subprocess.DEVNULL)
    if result.returncode not in (0, 1):
        raise RuntimeError("Cannot check whether Handy is running")
    return result.returncode == 0


def main():
    if not path.is_file():
        return
    store = json.loads(path.read_text())
    if updated(store) == store:
        return
    was_running = lifecycle.get("stop_before_update", True) and running()
    if was_running:
        subprocess.run(
            ["/usr/bin/osascript", "-e", 'tell application id "com.pais.handy" to quit'],
            timeout=5,
            check=True,
        )
        for _ in range(50):
            if not running():
                break
            time.sleep(0.1)
        if running():
            raise RuntimeError("Handy did not stop; settings were not changed")
    try:
        store = json.loads(path.read_text())
        result = updated(store)
        if result != store:
            with tempfile.NamedTemporaryFile(mode="w", dir=path.parent, delete=False) as file:
                try:
                    json.dump(result, file, indent=2, ensure_ascii=False)
                    file.write("\n")
                    file.flush()
                    os.replace(file.name, path)
                finally:
                    if os.path.exists(file.name):
                        os.unlink(file.name)
    finally:
        if was_running and lifecycle.get("restart_after_update", True):
            subprocess.run(["/usr/bin/open", "-b", "com.pais.handy"], check=True)


if __name__ == "__main__":
    main()
{{- end }}
