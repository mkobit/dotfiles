{{- $root := dig "local_bin_tools_root" .chezmoi.workingTree . -}}
{{- $misePath := joinPath ($root | toString) "mise.toml" -}}
{{- if and (ne (dig "local" "bin" "mise" "installation_method" "none" $) "none") (stat $misePath) -}}
#!/usr/bin/env bash
# mise version: {{ .bin.mise.version }}
# mise.toml hash: {{ include $misePath | sha256sum }}

set -euo pipefail

source "{{ .chezmoi.sourceDir }}/.chezmoitemplates/shell/logging.sh"

export PATH="{{ .chezmoi.destDir }}/.local/bin:${PATH}"

if ! command -v mise &>/dev/null; then
    log_warn "mise not found in PATH. Skipping trust and install for {{ $root }}."
    exit 0
fi

log_info "Trusting mise config: {{ $root }}/mise.toml"
mise trust "{{ $root }}/mise.toml"
log_success "Mise config trusted: {{ $root }}/mise.toml"

log_info "Installing mise tools in {{ $root }}..."
if mise install -C "{{ $root }}"; then
    log_success "Mise tools installed in {{ $root }}."
else
    log_error "Failed to install mise tools in {{ $root }}."
    exit 1
fi
{{- end -}}
