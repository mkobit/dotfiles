{{- $replacements := dig "macos" "text_replacements" (dict) . -}}
{{- if and (eq .chezmoi.os "darwin") $replacements -}}
#!/usr/bin/env bash

CHEZMOI_SOURCE_DIR={{ .chezmoi.sourceDir | quote }}
# shellcheck source=/dev/null
if ! source "${CHEZMOI_SOURCE_DIR}/.chezmoitemplates/shell/logging.sh"; then
    printf '%s\n' '[WARN] Could not load logging helper for macOS text replacements.' >&2
    exit 0
fi

if ! command -v python3 >/dev/null 2>&1; then
    log_warn 'Could not check macOS text replacements: python3 not found.' >&2
    exit 0
fi

if ! warnings="$(python3 - <<'PY'
import plistlib
import subprocess

desired = {{ $replacements | toJson }}

try:
    result = subprocess.run(["/usr/bin/defaults", "export", "-g", "-"], check=True, capture_output=True)
    current = plistlib.loads(result.stdout).get("NSUserDictionaryReplacementItems", [])
    missing = [
        (shortcut, phrase)
        for shortcut, phrase in desired.items()
        if not any(
            entry.get("on", True) and entry.get("replace") == shortcut and entry.get("with") == phrase
            for entry in current
        )
    ]
    for shortcut, phrase in missing:
        print(f"macOS text replacement missing or different: {shortcut} → {phrase}")
    if missing:
        print("Update these in System Settings > Keyboard > Text Replacements.")
except Exception as error:
    print(f"Could not check macOS text replacements: {type(error).__name__}")
PY
)"; then
    log_warn 'Could not run the macOS text replacement check.' >&2
    exit 0
fi

while IFS= read -r warning; do
    [[ -n "$warning" ]] || continue
    # The logging helper uses printf %b; keep replacement text literal.
    warning=${warning//\\/\\\\}
    log_warn "$warning" >&2
done <<< "$warnings"
{{- end }}
