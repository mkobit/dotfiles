{{- /* chezmoi:modify-template */ -}}
{{- /* OpenCode V1 accepts an absolute local package directory in plugin. */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $plugin := dig "ai" "plugins" "superpowers" (dict) . -}}
{{- $target := joinPath .chezmoi.destDir (dig "path" ".local/share/agent-plugins/marketplaces/superpowers-marketplace/plugins/superpowers" $plugin) -}}
{{- $installed := ne (dig "local" "bin" "opencode" "installation_method" "none" .) "none" -}}
{{- $enabled := and (eq (dig "installation_method" "none" $plugin) "chezmoi_external") $installed -}}
{{- $entries := dig "plugin" (list) $config -}}
{{- $legacy := joinPath .chezmoi.destDir ".local/share/agent-plugins/marketplace/plugins/superpowers" -}}
{{- $retired := and (ne $legacy $target) (has $legacy $entries) $installed -}}
{{- if $retired -}}
{{-   $entries = without $entries $legacy -}}
{{- end -}}
{{- $managed := has $target $entries -}}
{{- $changed := $retired -}}
{{- if and $enabled (not $managed) -}}
{{-   $_ := set $config "plugin" (append $entries $target) -}}
{{-   $changed = true -}}
{{- else if and (not $enabled) $managed -}}
{{-   $_ := set $config "plugin" (without $entries $target) -}}
{{-   $changed = true -}}
{{- else if $retired -}}
{{-   $_ := set $config "plugin" $entries -}}
{{- end -}}
{{- if and $installed (dig "ai" "ollama" "enabled" false .) -}}
{{-   $host := regexReplaceAll "/+$" (dig "ai" "ollama" "host_url" "" .) "" -}}
{{-   $sandbox := regexReplaceAll "/+$" (dig "ai" "ollama" "sandbox_url" "" .) "" -}}
{{-   $model := dig "ai" "ollama" "default_coder_model" "" . -}}
{{-   if not (and $host $sandbox $model) -}}
{{-     fail "Local model prerequisite: set both service roots and the default coder model." -}}
{{-   end -}}
{{-   $route := dict "model" (printf "ollama/%s" $model) "provider" (dict "ollama" (dict
        "npm" "@ai-sdk/openai-compatible" "name" "Ollama (configured)"
        "options" (dict "baseURL" (printf "%s/v1" $host))
        "models" (dict $model (dict "name" $model)))) -}}
{{-   $config = mergeOverwrite $config $route -}}
{{-   $changed = true -}}
{{- end -}}
{{- if $changed -}}
{{-   $config | toPrettyJson | trimSuffix "\n" -}}
{{- else -}}
{{-   .chezmoi.stdin | default "{}" -}}
{{- end -}}
