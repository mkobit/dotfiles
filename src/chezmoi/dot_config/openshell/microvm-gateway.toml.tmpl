{{- $stateDir := printf "%s/.local/state/openshell-microvm" .chezmoi.destDir -}}
[openshell]
version = 2

[openshell.gateway]
bind_address   = "127.0.0.1:17671"
compute_driver = "vm"
guest_tls_ca   = {{ printf "%s/tls/ca.crt" $stateDir | quote }}

[openshell.drivers.vm]
state_dir     = {{ printf "%s/vm" $stateDir | quote }}
driver_dir    = {{ printf "%s/.local/bin" .chezmoi.destDir | quote }}
default_image = "nvcr.io/nvidia/base/ubuntu:24.04"
