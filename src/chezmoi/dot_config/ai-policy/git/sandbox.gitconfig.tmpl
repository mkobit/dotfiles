{{- $signingKey := dig "ai" "sandbox" "signing_key" "" . -}}
# Global git config used inside OpenShell sandboxes via GIT_CONFIG_GLOBAL.
# Inherits the regular config, then overrides signing to use a dedicated
# agent signing-only SSH key when configured, or disables signing when absent.
[include]
	path = {{ .chezmoi.destDir }}/.dotfiles/git/config
[gpg]
	format = ssh
[gpg "ssh"]
	program = ssh-keygen
	defaultKeyCommand =
{{- if $signingKey }}
[user]
	signingkey = {{ $signingKey }}
[commit]
	gpgsign = true
[tag]
	gpgSign = true
{{- else }}
[commit]
	gpgsign = false
[tag]
	gpgSign = false
{{- end }}
