# Global git config used inside OpenShell sandboxes via GIT_CONFIG_GLOBAL.
# A signing session sets the signing configuration in its guest clone.
[include]
	path = {{ .chezmoi.destDir }}/.dotfiles/git/config
[gpg]
	format = ssh
[gpg "ssh"]
	program = ssh-keygen
	defaultKeyCommand =
[commit]
	gpgsign = false
[tag]
	gpgSign = false
