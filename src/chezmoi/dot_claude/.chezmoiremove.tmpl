{{- /*
  Emits tombstones for direct Claude skill roots. A selected capability-bundle
  skill has a native tombstone so chezmoi status and diff show its cutover from
  ~/.claude/skills/<name> to the plugin package. Bare skill names come from
  ai/agent-sources; deleted sources need no catalog key.
*/ -}}
{{- $hasBridge := false -}}
{{- range $capability := dig "capabilities" (dict) (dig "plugin_bridge" (dict) .ai) -}}
{{-   if has "claude" (dig "hosts" (list) $capability) -}}
{{-     $hasBridge = true -}}
{{-   end -}}
{{- end -}}
{{- range $sourceName, $source := dig "external" (dict) (dig "skills" (dict) .ai) -}}
{{-   range $skillName, $state := dig "skills" (dict) $source -}}
{{-     if or $hasBridge (not (or (eq $state "present") (eq $state "claude"))) }}
skills/{{ $skillName }}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- range $skillName, $skill := (includeTemplate "ai/agent-sources" . | fromJson).bare.skills -}}
{{-   if or $hasBridge (not (or (eq $skill.state "present") (eq $skill.state "claude"))) }}
skills/{{ $skillName }}
{{-   end -}}
{{- end -}}
{{- /* Retired authored skills whose sources are deleted. */ -}}
{{- range $skillName := list "docker-sandboxes" "pr-reviewer" "typescript-expert" }}
skills/{{ $skillName }}
{{- end }}

plugins/cache/dotfiles/mkobit-dotfiles/*/skills/docker-sandboxes
