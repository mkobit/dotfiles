{{- $enabled := and (eq (dig "wsl" "windows_integration" false . | toJson) "true") (eq .chezmoi.os "linux") (contains "microsoft" (lower .chezmoi.kernel.osrelease)) (lookPath "wslpath") -}}
{{- $cmd := and $enabled (stat "/mnt/c/Windows/System32/cmd.exe") -}}
{{- if and $cmd (eq $cmd.type "file") (regexMatch "[1357]" (printf "%03o" $cmd.perm)) -}}
#!/usr/bin/env bash
set -euo pipefail

# .wslconfig hash: {{ includeTemplate "wsl/wslconfig" . | sha256sum }}

# .wslconfig must reside in the Windows user profile, which is outside the
# standard Linux home directory managed by chezmoi. This script templates
# and copies the configuration to the Windows user profile.

WIN_PROFILE=$(/mnt/c/Windows/System32/cmd.exe /c "echo %USERPROFILE%" 2>/dev/null | tr -d '\r')
if [[ -z "${WIN_PROFILE}" ]]; then
  echo "ERROR: Could not determine Windows user profile path via cmd.exe" >&2
  exit 1
fi
WSL_PROFILE=$(wslpath -u "$WIN_PROFILE")
if [[ "$WSL_PROFILE" != /* || "$WSL_PROFILE" == / || ! -d "$WSL_PROFILE" ]]; then
  echo "ERROR: Could not resolve the Windows user profile directory" >&2
  exit 1
fi
WSLCONFIG_PATH="$WSL_PROFILE/.wslconfig"

cat > "${WSLCONFIG_PATH}" << 'CONFIG_EOF'
{{ template "wsl/wslconfig" . }}
CONFIG_EOF

echo "Updated .wslconfig: ${WSLCONFIG_PATH}"
{{- end -}}
