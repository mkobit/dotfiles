{{- /*
  Emits tombstones for direct Codex skill roots. Every catalog and base bare skill
  deploys inside plugin packages, so old copies under ~/.codex/skills/<name> go.
  Base bare and retired names come from the shared ai/retired-skills list.
*/ -}}
{{- range $sourceName, $source := dig "external" (dict) (dig "skills" (dict) .ai) -}}
{{-   range $skillName, $_ := dig "skills" (dict) $source }}
skills/{{ $skillName }}
{{-   end -}}
{{- end -}}
{{- range $skillName := includeTemplate "ai/retired-skills" . | fromJson }}
skills/{{ $skillName }}
{{- end }}
plugins/cache/dotfiles/mkobit-dotfiles/*/skills/docker-sandboxes
