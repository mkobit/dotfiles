{{- /*
  Emits tombstones for direct Cursor skill roots. Every catalog and base bare skill
  deploys inside plugin packages, so old copies under ~/.cursor/skills/<name> go.
  Base bare and retired names come from the shared ai/retired-skills list.
*/ -}}
{{- range $sourceName, $source := dig "external" (dict) (dig "skills" (dict) .ai) -}}
{{-   range $skillName, $_ := dig "skills" (dict) $source }}
skills/{{ $skillName }}
{{-   end -}}
{{- end -}}
{{- range $skillName := includeTemplate "ai/retired-skills" . | fromJson }}
skills/{{ $skillName }}
{{- end }}

{{- range $sourceName, $source := dig "external" (dict) (dig "agents" (dict) .ai) -}}
{{-   range $agentPath, $state := dig "agents" (dict) $source -}}
{{-     if not (or (eq $state "present") (eq $state "cursor")) }}
skills/{{ base $agentPath }}
{{-     end -}}
{{-   end -}}
{{- end -}}

{{- /* Authored plugins reach Cursor through the dotfiles marketplace, not local copies. */ -}}
{{- range $name, $_ := includeTemplate "ai/authored-plugins" . | fromJson }}
plugins/local/{{ $name }}
{{- end -}}

{{- /* Remove only known upstream Cursor packages when acquisition is disabled. */ -}}
{{- range $name, $capability := dig "ai" "plugin_bridge" "capabilities" (dict) . -}}
{{-   $source := dig "external_source" "" $capability -}}
{{-   if and $source (has "cursor" (dig "hosts" (list) $capability)) -}}
{{-     if ne (dig "ai" "plugins" $source "installation_method" "none" $) "chezmoi_external" }}
plugins/local/{{ $name }}
{{-     end -}}
{{-   end -}}
{{- end -}}
