{{- /*
  Emits tombstones for direct Cursor skill roots. A selected capability-bundle
  skill has a native tombstone so chezmoi status and diff show its cutover from
  ~/.cursor/skills/<name> to the plugin package. Agent cleanup and the
  state-manifest hook continue to handle their existing lifecycle cases.
*/ -}}
{{- $capabilities := dig "capabilities" (dict) (dig "plugin_bridge" (dict) .ai) -}}
{{- $baseBridge := hasKey $capabilities "mkobit-dotfiles" -}}
{{- $overlayBridge := hasKey $capabilities "stripe-dotfiles" -}}
{{- range $sourceName, $source := .ai.skills.external -}}
{{-   range $skillName, $state := dig "skills" (dict) $source -}}
{{-     if or $baseBridge (not (or (eq $state "present") (eq $state "cursor"))) }}
skills/{{ $skillName }}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- range $skillName, $state := dig "authored" (dict) .ai.skills -}}
{{-   if or $baseBridge (not (or (eq $state "present") (eq $state "cursor"))) }}
skills/{{ $skillName }}
{{-   end -}}
{{- end -}}
{{- $isLocal := stat "/Applications/Santa.app" -}}
{{- if $overlayBridge -}}
{{-   range $skillName, $state := dig "overlay_skills" "authored" (dict) .ai -}}
{{-     $active := or (eq $state "present") (eq $state "cursor") (and (eq $state "local") $isLocal) -}}
{{-     if $active }}
skills/{{ $skillName }}
{{-     end -}}
{{-   end -}}
{{- end -}}
{{- range $sourceName, $source := dig "external" (dict) (dig "agents" (dict) .ai) -}}
{{-   range $agentPath, $state := dig "agents" (dict) $source -}}
{{-     if not (or (eq $state "present") (eq $state "cursor")) }}
skills/{{ base $agentPath }}
{{-     end -}}
{{-   end -}}
{{- end -}}
