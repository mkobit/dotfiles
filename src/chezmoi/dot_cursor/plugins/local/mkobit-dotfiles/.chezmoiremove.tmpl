{{- /*
  Removes Cursor-local plugin skill directories when their catalog state no
  longer selects Cursor. Paths are relative to this plugin's target root.
*/ -}}
{{- $record := dict -}}
{{- range $skillName, $state := dig "authored" (dict) (dig "skills" (dict) .ai) -}}
{{-   $_ := set $record $skillName $state -}}
{{- end -}}
{{- range $sourceName, $source := dig "external" (dict) (dig "skills" (dict) .ai) -}}
{{-   range $skillName, $state := dig "skills" (dict) $source -}}
{{-     $_ := set $record $skillName $state -}}
{{-   end -}}
{{- end -}}
{{- range $skillName, $state := $record -}}
{{-   if not (or (eq $state "present") (eq $state "cursor")) }}
skills/{{ $skillName }}
{{-   end -}}
{{- end -}}
