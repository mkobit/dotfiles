{{- /*
  Removes deselected external skills and retired authored skills from the Cursor-local
  plugin. Paths are relative to this plugin's target root. Bare skill roots are exact_
  and cleaned by the root cleanup.
*/ -}}
{{- $record := dict -}}
{{- range $sourceName, $source := dig "external" (dict) (dig "skills" (dict) .ai) -}}
{{-   range $skillName, $state := dig "skills" (dict) $source -}}
{{-     $_ := set $record $skillName $state -}}
{{-   end -}}
{{- end -}}
{{- range $skillName, $state := $record -}}
{{-   if not (or (eq $state "present") (eq $state "cursor")) }}
skills/{{ $skillName }}
{{-   end -}}
{{- end -}}
{{- range $skillName := (includeTemplate "ai/retired-skills" . | fromJson) }}
skills/{{ $skillName }}
{{- end -}}
